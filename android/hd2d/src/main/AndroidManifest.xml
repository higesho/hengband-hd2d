<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ゲームパッド（Bluetooth / USB）は任意。無くても動く -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- ボクセル HD2D は GLES 3.0 以上（3.2 → 3.1 → 3.0 と下げながら試す。
         エミュレータが 3.1 止まりのため下限をここに置く。 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:hasFragileUserData="true"
        android:theme="@style/HengbandTheme">

        <!-- 向きは `fullUser`。
             **ここが `sensorLandscape` のままだと縦の画面構成は一度も出ない**——端末が回っても
             窓の形が変わらないので、向きを見るこちらの仕組みが動きようがない。
             `fullUser` ＝ 4 方向すべて許すが、**端末の回転ロックには従う**
             （`sensor` だと寝転がって遊ぶたびに勝手に回る）。`configChanges` に
             `orientation|screenSize` があるので、回ってもアクティビティは作り直されず
             SDL の窓の大きさが変わるだけである。 -->
        <activity
            android:name=".HengbandHd2dActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="fullUser"
            android:launchMode="singleInstance"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">

            <!-- 裏へ回ったらゲームスレッドを止める（旧版と同じ。A-01 の前提） -->
            <meta-data android:name="SDL_ENV.SDL_ANDROID_BLOCK_ON_PAUSE" android:value="1" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
