<?xml version="1.0" encoding="utf-8"?>
<!--
  HengbandHd2d.vcxproj — ボクセル HD2D の実行体（プロトコル v1 の第 3 の ui）。

  定義の置き場: ボクセル HD2D の設計 §2・§3 /
        / プロトコル v1 の仕様

  中身は `hd2d/` 全部 ＋ `presentation/frame/` の中立 TU ＋ `platform/windows/hd2d_main.cpp`。
  **`src/` も `ui/` も入れない。**この exe はコアの型も既存 ui の作りも 1 つも知らない
  （設計書 必守制約 1・5・6）。

  描画は OpenGL 4.6 core。**`opengl32.lib` はリンクしない**（1.1 の口しか出さないので
  意味が無い）。関数は全部 `hd2d/render/gl_core.cpp` が `SDL_GL_GetProcAddress` で引く。
  SDL2 は窓・入力・フォントにだけ使う（`SDL2_image` も要らない）。

  全 TU が PCH 無効・UTF-8（`presentation/frame` は SJIS を通らない）なので、
  TU ごとにメタデータを書かず ItemDefinitionGroup にまとめる。
  `..\..\src` を include 経路に入れているのは `external-lib/include-json.h`
  （nlohmann の入口）がそこにあるためだけで、コアのヘッダは 1 つも引かない。
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <!--
      **x64 だけ。** SteamVR の OpenXR ランタイムが 32bit へ提供されていないので、
      画面側は x64 でなければ VR に行けない。
      コア（HengbandCore）と上流版（Hengband）は Win32 のまま。別プロセスで
      パイプはバイト列なので混在してよい。

      Win32 の構成は**消してある**。残すと (a) 同じ `HengbandHd2d.exe` を 2 つの構成が
      奪い合って前の版が残る、(b) `hd2d/xr/` が x86 の openxr-loader を要求する、
      の 2 つを抱えることになる。画面を Win32 で組む用は VR 以後もう無い。
    -->
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7E2A1C40-2B6E-4E7D-9C31-0C4F1B5A9D03}</ProjectGuid>
    <RootNamespace>HengbandHd2d</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- 構成は x64 だけ（上の注記）。Debug と Release で違うのは最適化と CRT の枝 -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup Label="HengbandSdl">
    <!--
      三つ組は Platform から引く（いまは x64 だけ）。導入は の Windows 節と
      。**`sdl2-ttf` は重ね三つ組で組み直すこと**——
      素の /O2 だと x64 で字が欠ける（同 罠 15）。
    -->
    <HengbandVcpkgRoot Condition="'$(HengbandVcpkgRoot)' == ''">C:\vcpkg</HengbandVcpkgRoot>
    <HengbandVcpkgTriplet Condition="'$(Platform)' == 'x64'">x64-windows</HengbandVcpkgTriplet>
    <HengbandVcpkgTriplet Condition="'$(HengbandVcpkgTriplet)' == ''">x86-windows</HengbandVcpkgTriplet>
    <HengbandSdlInclude>$(HengbandVcpkgRoot)\installed\$(HengbandVcpkgTriplet)\include</HengbandSdlInclude>
    <HengbandSdlLibRelease>$(HengbandVcpkgRoot)\installed\$(HengbandVcpkgTriplet)\lib</HengbandSdlLibRelease>
    <HengbandSdlLibDebug>$(HengbandVcpkgRoot)\installed\$(HengbandVcpkgTriplet)\debug\lib</HengbandSdlLibDebug>
    <HengbandSdlBinRelease>$(HengbandVcpkgRoot)\installed\$(HengbandVcpkgTriplet)\bin</HengbandSdlBinRelease>
    <HengbandSdlBinDebug>$(HengbandVcpkgRoot)\installed\$(HengbandVcpkgTriplet)\debug\bin</HengbandSdlBinDebug>
  </PropertyGroup>
  <PropertyGroup Label="HengbandHd2dEditor">
    <!--
      ボクセルエディタ（P9・R13）。**既定で入る**（開発の道具なので）。
      リリース用（配布物）は `/p:HengbandHd2dEditor=0` で hd2d\edit\ の TU と
      HD2D_EDITOR 定義が丸ごと外れる（2026-08-08 に決めた「内蔵するが、
      リリース用には含めない」）。

      **出力はリポジトリ直下ではなく `dist-noeditor\` へ**（DLL も PostBuildEvent が
      そこへ写すので、そのまま配布物の器になる）。中間物も分ける。開発用の exe と
      同じパスへ書くと、切り替え直後の増分ビルドが「出力のほうが新しい」と読んで
      リンクを飛ばし、**エディタ無しの exe が残ったまま**になる（実際に踏んだ）。
    -->
    <HengbandHd2dEditor Condition="'$(HengbandHd2dEditor)' == ''">1</HengbandHd2dEditor>
    <HengbandHd2dEditorDefine Condition="'$(HengbandHd2dEditor)' != '0'">HD2D_EDITOR=1;</HengbandHd2dEditorDefine>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      出力はリポジトリ直下（`HengbandCore.exe` を exe と同じ場所から起こすため。
      `core_link.cpp` の `exe_directory()`）。中間物は三つ組ごとに分ける。
    -->
    <OutDir>..\..\</OutDir>
    <OutDir Condition="'$(HengbandHd2dEditor)' == '0'">..\..\dist-noeditor\</OutDir>
    <IntDir>$(Configuration)\</IntDir>
    <IntDir Condition="'$(HengbandHd2dEditor)' == '0'">$(Configuration)-noeditor\</IntDir>
    <IntDir Condition="'$(Platform)' == 'x64'">$(Configuration)-x64\</IntDir>
    <IntDir Condition="'$(HengbandHd2dEditor)' == '0' AND '$(Platform)' == 'x64'">$(Configuration)-noeditor-x64\</IntDir>
    <TargetName>HengbandHd2d</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>$(HengbandHd2dEditorDefine)WINDOWS;_CRT_SECURE_NO_WARNINGS;WIN32;HAVE_STDINT_H;WIN_DEBUG;SDL_MAIN_HANDLED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <DebugInformationFormat>EditAndContinue</DebugInformationFormat>
      <CompileAs>CompileAsCpp</CompileAs>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ExceptionHandling>SyncCThrow</ExceptionHandling>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalOptions>/source-charset:utf-8 /execution-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>..\..\hd2d;..\..\presentation;..\..\src;..\..\src\external-lib\include;$(HengbandSdlInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <DisableSpecificWarnings>4820;4514;4710;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <TreatAngleBracketIncludesAsExternal>true</TreatAngleBracketIncludesAsExternal>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <TargetMachine Condition="'$(Platform)'=='Win32'">MachineX86</TargetMachine>
      <TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
      <AdditionalLibraryDirectories>$(HengbandSdlLibDebug);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL2d.lib;SDL2_ttfd.lib;SDL2_imaged.lib;openxr_loaderd.lib;OpenAL32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Windows</SubSystem>
    </Link>
    <PostBuildEvent>
      <Command>if not exist "$(OutDir)" mkdir "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\SDL2d.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\SDL2_ttfd.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\SDL2_imaged.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\freetyped.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\libpng16d.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\zd.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\bz2d.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\brotlicommon.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\brotlidec.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\brotlienc.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\openxr_loaderd.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\OpenAL32.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\fmtd.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinDebug)\jsoncpp.dll" "$(OutDir)"
</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>$(HengbandHd2dEditorDefine)WINDOWS;_CRT_SECURE_NO_WARNINGS;WIN32;HAVE_STDINT_H;SDL_MAIN_HANDLED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <CompileAs>CompileAsCpp</CompileAs>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ExceptionHandling>SyncCThrow</ExceptionHandling>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalOptions>/source-charset:utf-8 /execution-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>..\..\hd2d;..\..\presentation;..\..\src;..\..\src\external-lib\include;$(HengbandSdlInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <DisableSpecificWarnings>4820;4514;4710;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <TreatAngleBracketIncludesAsExternal>true</TreatAngleBracketIncludesAsExternal>
    </ClCompile>
    <Link>
      <TargetMachine Condition="'$(Platform)'=='Win32'">MachineX86</TargetMachine>
      <TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
      <AdditionalLibraryDirectories>$(HengbandSdlLibRelease);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL2.lib;SDL2_ttf.lib;SDL2_image.lib;openxr_loader.lib;OpenAL32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <SubSystem>Windows</SubSystem>
    </Link>
    <PostBuildEvent>
      <Command>if not exist "$(OutDir)" mkdir "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\SDL2.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\SDL2_ttf.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\SDL2_image.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\freetype.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\libpng16.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\z.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\bz2.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\brotlicommon.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\brotlidec.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\brotlienc.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\openxr_loader.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\OpenAL32.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\fmt.dll" "$(OutDir)"
copy /Y "$(HengbandSdlBinRelease)\jsoncpp.dll" "$(OutDir)"
</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
