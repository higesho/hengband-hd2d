 「原作の再構成と Linux」）。 -->
    <DcssSourceRoot Condition="'$(DcssSourceRoot)'=='' And '$(DCSS_SOURCE_ROOT)'!=''">$(DCSS_SOURCE_ROOT)</DcssSourceRoot>
    <DcssSourceRoot Condition="'$(DcssSourceRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\roguelike-cores\build-sources\dcss\crawl-ref\source'))</DcssSourceRoot>
    <!-- 生成物の置き場。既定は原作の置き場そのもの（その場で生成する運用のとき）。 -->
    <DcssGenRoot Condition="'$(DcssGenRoot)'=='' And '$(DCSS_GEN_ROOT)'!=''">$(DCSS_GEN_ROOT)</DcssGenRoot>
    <DcssGenRoot Condition="'$(DcssGenRoot)'==''">$(DcssSourceRoot)</DcssGenRoot>
    <DcssAdapterRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\dcss\adapter'))</DcssAdapterRoot>
    <DcssRepoRoot>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))'))</DcssRepoRoot>
    <!-- 成果物はリポジトリ直下（ほかのコアと同格）。検査では /p:OutDir= で一時フォルダへ向ける（コマンドラインの値が勝つので、ここは無条件に書く。
         条件つきだと MSBuild の既定の OutDir（x64\Release\）が先に入っていて効かなかった）。中間物は Release-x64\（.gitignore 済み）。 -->
    <OutDir>..\..\</OutDir>
    <IntDir>$(Configuration)-x64\</IntDir>
    <TargetName>DcssCore</TargetName>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
