    <Error Condition="!Exists('$(DcssGenRoot)\mon-data.h')" Text="DCSS の生成物がありません: $(DcssGenRoot)。先に python dcss/adapter/prepare_gen.py --work &lt;作業フォルダ&gt; を実行し、/p:DcssGenRoot=&lt;作業フォルダ&gt;\gen を指してください。" />
  </Target>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level1</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>false</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>AppHdr.h</PrecompiledHeaderFile>
      <LanguageStandard>stdcpp14</LanguageStandard>
      <ConformanceMode>false</ConformanceMode>
      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
      <DisableSpecificWarnings>4138;4244;4267;4996;4146;4309;4005;4819;4101;4018;4800;4834;4455;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <!--
        並びが効く。生成物 → 互換ヘッダ（sys/*.h）→ 原作 の順。原作に同名の物は無いが、
        sys/un.h・sys/socket.h・sys/time.h は MSVC に無いので、このフォルダの物が使われる。
        MSVC/include は原作が Windows 用に持っている sys/param.h。
      -->
      <AdditionalIncludeDirectories>$(DcssGenRoot);$(DcssGenRoot)\rltiles;$(DcssAdapterRoot);$(DcssAdapterRoot)\shim;$(DcssSourceRoot);$(DcssSourceRoot)\MSVC\include;$(DcssSourceRoot)\rltiles;$(DcssSourceRoot)\contrib\lua\src;$(DcssSourceRoot)\contrib\sqlite;$(DcssSourceRoot)\contrib\pcre;$(DcssSourceRoot)\contrib\zlib;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;_USE_MATH_DEFINES;_ALLOW_KEYWORD_MACROS;__STDC_LIMIT_MACROS;WIZARD;CLUA_BINDINGS;USE_TILE;USE_TILE_WEB;PCRE_STATIC;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- 窓は持たない。標準出力がプロトコル（いまは仮の JSON の行）、標準エラーがログ。 -->
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>winmm.lib;shell32.lib;user32.lib;advapi32.lib;ole32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
