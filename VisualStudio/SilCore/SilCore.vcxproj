  </ItemGroup>
  <!--
    アダプタ（新規コード。設計 §3）。C の皮と C++ の芯。
    P2 で `sq_frame.cpp` / `sq_manifest.cpp` / `sq_pad_commands.cpp` と、
    `presentation/frame` の共用 TU がここへ増える。
  -->
  <ItemGroup>
    <ClCompile Include="..\..\silq\adapter\sq_bootstrap.c" />
    <ClCompile Include="..\..\silq\adapter\sq_null_term.c" />
    <ClCompile Include="..\..\silq\adapter\sq_shim.c" />
    <!--
      日本語層の C 側。`silq/src` から見えるのは
      `sq_lang_c.h` だけで、実体はここと `sq_lang.cpp` に分かれている。
      **BOM 付き UTF-8 なので `/source-charset:utf-8` は要らない。**
    -->
    <ClCompile Include="..\..\silq\adapter\sq_lang_c.c" />
    <!--
      名前の日本語での組み立て。**C である**
      ——`object_type` / `k_info` / `a_info` の中身が要るので、`sq_shim.c` と
      同じ「Sil-Q のヘッダを見てよい C の TU」に置いた。
    -->
    <ClCompile Include="..\..\silq\adapter\sq_name_ja.c" />
    <!--
      サブパネル用の Term 7 枚。**C である**
      ——`angband_term` / `op_ptr->window_flag` / `term_init` を触るので、
      `sq_shim.c` と同じ「Sil-Q のヘッダを見てよい C の TU」に置いた。
    -->
    <ClCompile Include="..\..\silq\adapter\sq_sub_terms.c" />
    <ClCompile Include="..\..\silq\adapter\sq_frame.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="..\..\silq\adapter\sq_manifest.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!--
      選ぶ画面をコアが名乗る層。
      `menu_choices` / `prompt` / `numeric` を埋める。
    -->
    <ClCompile Include="..\..\silq\adapter\sq_menu.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- サブパネルの C++ 側（種類の申告・希望の当て・文字の積み。同 §2）。 -->
    <ClCompile Include="..\..\silq\adapter\sq_sub_panels.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="..\..\silq\adapter\sq_pad_commands.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="..\..\silq\adapter\sq_main.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- 日本語層の C++ 側。 -->
    <ClCompile Include="..\..\silq\adapter\sq_lang.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="..\..\silq\adapter\sq_text.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemGroup>
  <!--
    変愚と**同一ファイル**の共用 TU（設計 §1 制約 3）。ここは 1 バイトも改変しない。
    `frame_codec` はプロトコル v1 の frame を、`protocol_messages` は制御メッセージを、
    `protocol_transport` は長さ枠を、`input_event_adapter` は抽象入力（v1 §8.3）を
    キーバイト列へ展開する。どれも `frame/` のヘッダと nlohmann しか見ないので、
    コアに依らない。**UTF-8 だが BOM が無い**ので `/source-charset:utf-8` が要る。
  -->
  <ItemGroup>
    <!--
      Windows API の代役をまとめた層（`platform/portable/legacy_os.cpp`）。
      **Windows でもここを通す**——中身は各アダプタに在ったものの写しで、
      平台の分岐をあの 1 ファイルへ閉じ込めるためだけに切り出した
      。BOM 無しの UTF-8 なので上と同じ扱い。
      `cp932.cpp` は**足さない**: あれは Windows 以外の変換の実体で、
      こちらは `MultiByteToWideChar` を使うため 1 行も要らない。
    -->
    <ClCompile Include="..\..\platform\portable\legacy_os.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClInclude Include="..\..\platform\portable\legacy_os.h" />
    <ClInclude Include="..\..\platform\portable\legacy_os_c.h" />
    <ClCompile Include="..\..\presentation\frame\frame_codec.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="..\..\presentation\frame\protocol_messages.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="..\..\presentation\frame\protocol_transport.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="..\..\presentation\bridge\input_event_adapter.cpp">
      <AdditionalOptions>/source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
