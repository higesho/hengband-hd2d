# =====================================================================
# SDL2 UI 改修用ローカルリポジトリ向け追加
# 方針: 「本改修の成果物」と「再取得できない生成アセット」は追跡し、
#       ビルド出力・上流から再取得できる実体・実行時状態は追跡しない。
# =====================================================================

# vcpkg 由来の再配布 DLL（FLAG ON 構成のビルド後イベントが自動コピーする）
/*.dll

# ゲームが cwd へ書き出す SDL2 UI 実行時設定（機能メニューの操作結果。K-10）
/sdl2_ui_options.cfg
/sdl2_pad_binds.cfg

# 上流サブモジュールの実体（.gitmodules は上流ファイルとして残置）
#   lib/xtra = https://github.com/hengband/hengband.xtra
#   BGM/SE 計 93MB。上流から再取得可能なため追跡しない。
#   libcurl（上流版 Hengband.exe だけが使う）はこの公開版に含めない。
lib/xtra/

# 幻想蛮怒側の音の素材。**上と同じ実体**（hengband.xtra から写したもの）なので
# ここでも追跡しない。設定ファイル（*.cfg）は割り当てを書くので追跡する。
gensoband/lib/xtra/sound/*.wav
gensoband/lib/xtra/music/*.mp3
gensoband/lib/xtra/music/*.ogg
gensoband/lib/xtra/music/*.mid

# 画面側の環境音。**ベッドだけ追跡しない。**
#   1 本 1.4MB × 9 で 13MB あり、しかも「後で AI を重ねる」前提の暫定物なので、
#   作り直すたび履歴が 13MB ずつ太る。tools/gen_audio_assets.py は種を固定してあって
#   **何度作っても同じバイト列**になる（実測）ので、必要なら 4 秒で戻せる:
#       python tools/gen_audio_assets.py
#   規則（ambience.jsonc）・目録（sfx.jsonc）・効果音（se/）は追跡する。
#   効果音を追跡するのは、配り先の lib/xtra/sound が追跡外だからで、
#   **ここが唯一の定義の置き場**になるためである。
assets/audio/bed/
# 生成 AI の試作（tools/gen_audio_ai.py）。**当たりを選ぶまでの置き場**なので追跡しない。
# 選んだものを assets/audio/bed/ や se/ へ移す。
assets/audio/ai/


# 上流の *.log 除外により MSBuild フルログ（約 70MB）は追跡されない。
# ただし各 Phase レビューが合否の証拠として参照する計測ログのみ追跡する。
!docs/layout_check_*.log
!docs/tile_check_*.log
# HD2D の自動スモークが残す証跡（上流の *.log 除外に掛かって消えないよう明示する）
#   hd2d_switch_smoke.log = 描画経路の実行時切替（設計書 §9.3）
#   hd2d_scene_smoke.log  = 合成フレームの 3D 描画と各段の glGetError
!docs/hd2d_switch_smoke.log
!docs/hd2d_scene_smoke.log
# パッド割り当ての自己検査が残す証跡（HENGBAND_SDL2_PADBIND_SMOKE）。
#   padbind_smoke.log = コマンド表・キーマップ逆引き・cfg 互換・一覧の窓の判定結果。
#   docs/build_*_summary.log を追跡しているのに、その要約が参照する検査ログ本体が
#   追跡外だと合否を後から確かめられない。扱いを揃える。
!docs/padbind_smoke.log

# 生成スクリプトが作る一時バックアップ（git が履歴を持つため追跡しない）
*.csv.bak

# 生成スクリプトが作る差し替え前バックアップ（git が履歴を持つため追跡しない）
*.png.orig

# 目視チェック HTML のサムネイル（tilework/sfc から再生成できる派生物・37MB）
#   python tools/gen_monster_tile_review.py で作り直せる
docs/tile_review/thumbs/

# ビルドの証跡は「判定行だけを抜いた要約」を追跡する。
#   レビューで「対応するビルドログが 1 本も無い」と差し戻されたため証跡自体は要るが、
#   MSBuild のフルログは 1 本 2.5MB・docs 配下だけで 66MB あり、§11.1 で「生成物として
#   除外」と決めた対象そのもの。`!docs/*.log` で一括復活させるとその判断を黙って覆すことになる。
#   要約（警告・エラーの件数と完了行）があれば後から確かめる材料としては足りる。
!docs/build_*_summary.log

