assets/voxel/slab/.slab_manifest.json

# --------------------------------------------------- 幻想蛮怒コア（GensobandCore）
# 方針は変愚側と同じで、
# **写しの本体は追跡し、実行時に生まれるものだけ外す**。
#   写しの経緯と除外物は gensoband/UPSTREAM.md に書いてある。

# ビルド成果物（出力先はリポジトリ直下。HengbandCore.exe と同格）
/GensobandCore.exe

# 実行時に書かれるもの。lib は gensoband/ の中に閉じており、変愚の lib/ とは交差しない（R5）。
#   save = セーブデータ / apex = スコア（scores.raw）/ bone = 墓 / user = ユーザ設定
#   data = edit/*.txt を作った *_j.raw の置き場（init2.c の init_info が書く）
# 先方が置いている delete.me と、こちらで足した .gitkeep は残す（空でもディレクトリが要る）。
gensoband/lib/save/*
!gensoband/lib/save/.gitkeep
gensoband/lib/data/*
!gensoband/lib/data/.gitkeep
gensoband/lib/apex/*
!gensoband/lib/apex/delete.me
gensoband/lib/bone/*
!gensoband/lib/bone/delete.me
gensoband/lib/user/*
!gensoband/lib/user/delete.me
# 英語化。lib-en は build_en_edit.py の生成物、
# data-en は英語用 raw の置き場（raw の名が %s_j.raw 固定なので日本語と分ける）。
# 訳文の基準は gensoband/lang/en/（追跡する）。
gensoband/lib-en/
gensoband/lib/data-en/

# 短愚蛮怒（tangband/）も同じ建付け。edit/ は取り込みデータなので追跡し、
# 実行時に書かれる save/apex/bone/data/user だけ外す（tangband/UPSTREAM.md）。
# TangbandCore.exe は当方の木から組む成果物（VisualStudio/TangbandCore）。
/TangbandCore.exe
/TangbandCore.pdb
tangband/lib/save/*
!tangband/lib/save/delete.me
tangband/lib/data/*
!tangband/lib/data/delete.me
tangband/lib/apex/*
!tangband/lib/apex/delete.me
tangband/lib/bone/*
!tangband/lib/bone/delete.me
tangband/lib/user/*
!tangband/lib/user/delete.me

# 先方の main-win.c が exe の隣へ書く設定ファイル。今は使っていないが、
# 走らせ方を変えたときに紛れ込まないよう先に外しておく。
/Gensoband.INI

# 生成タイル（gensoband/tilework/ascii/）と作った板（gensoband/assets/slab/）の
# 扱いは **PT 段の判断に任せる**。P1 は実行時生成物だけを外す。


# ------------------------------------------------------- Sil-Q コア（SilCore）
# 建付けは他の別コアと同じで、
# **写しの本体は追跡し、実行時に生まれるものだけ外す**（経緯は silq/UPSTREAM.md）。
/SilCore.exe
/SilCore.pdb
# save = セーブ / apex = スコア / data = edit/*.txt を作った raw / user = ユーザ設定
# こちらで足した .keepalive は残す（空でもディレクトリが要る。先方は道を組むだけで作らない）。
silq/lib/save/*
!silq/lib/save/.keepalive
silq/lib/data/*
!silq/lib/data/.keepalive
silq/lib/apex/*
!silq/lib/apex/.keepalive
silq/lib/user/*
!silq/lib/user/.keepalive
# 日本語化。
# **訳文（silq/lang/ja/）は追跡する**——あれが本体である。
# 外すのは作成した物だけ: lib-ja/edit（CP932 の edit）・lib-{ja,en}/help（マニュアル）と
# lib/data-ja（その raw）。マニュアルの基準は silq/lang/{ja,en}/help/ にある（設計 §8.6）。
silq/lib-ja/
silq/lib-en/
silq/lib/data-ja/

# 幻想蛮怒のタイル作業台（tools/gensoband/tile_review_server.py）
# **参考画像（refs/）は追跡する**——その絵がどう決まったかの記録だから。
# 焼き直す前の退避（prev/）は見比べ用の控えなので追跡しない。
gensoband/tilework/prev/

# 幻想蛮怒のタイル作業台（続き）。**見直し用の使い捨て**は追跡しない。
#   _*.png … その場で並べた見本（いつでも作り直せる）
#   _comfy_cap/ … ComfyUI の記録・pid・仕込みの sitecustomize
# 点検の報告（_hole_check/ _shadow_check/）は**残す**——定義の置き場が根拠として指しているため。
gensoband/tilework/_*.png
tools/gensoband/_comfy_cap/

# ------------------------------------------------- FroxComposband コア（FroxCore）
# 建付けは他の別コアと同じで、
# **写しの本体は追跡し、実行時に生まれるものだけ外す**（経緯は frox/UPSTREAM.md）。
/FroxCore.exe
/FroxCore.pdb
# save = セーブ / apex = スコア / data = edit/*.txt を作成した raw /
# bone = 亡骸 / user = ユーザ設定
# こちらで足した .keepalive は残す（空でもディレクトリが要る。先方は道を組むだけで作らない）。
frox/lib/save/*
!frox/lib/save/.keepalive
frox/lib/data/*
!frox/lib/data/.keepalive
frox/lib/apex/*
!frox/lib/apex/.keepalive
frox/lib/bone/*
!frox/lib/bone/.keepalive
frox/lib/user/*
!frox/lib/user/.keepalive

# **訳文（frox/lang/ja/）は追跡する**——あれが本体である。
# 外すのは作成した物だけ: lib-ja/edit（CP932 の edit）・lib-ja/help・lib/data-ja（その raw）。
frox/lib-ja/
frox/lib/data-ja/

