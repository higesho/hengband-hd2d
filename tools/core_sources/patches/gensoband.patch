-/*:::文字の入力を受け付ける。詳細未読*/
-bool askfor_aux(char *buf, int len, bool numpad_cursor)
-{
-	int y, x;
-	int pos = 0;
-
-	/*
-	 * Text color
-	 * TERM_YELLOW : Overwrite mode
-	 * TERM_WHITE : Insert mode
