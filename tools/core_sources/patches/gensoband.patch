+/*:::長い文字列(スペース、改行を含み\0（？）で区切られる）へのポインタから\0までの文を抜き出す。漢字コード対応。
+ *:::英文の場合単語が切れないよう適切に改行する。出力文字の改行には\0を使っている。文末は\0\0。
+ *:::日本語の場合単語が切れない処理はしないが、特定の文字の直前で改行されてしまう場合少し戻して改行する？
+ *:::str:入力文字列へのポインタ
+ *:::maxlen:行ごとの最大出力文字数
+ *:::tbuf:出力バッファ
+ *:::word_punct:最後に通過した半角スペースの位置を記憶していると思われる。日本語ではかなり適当に使われてるっぽい。
+ *:::line_len:行の中の文字数
+ *:::read_pt:入力文字列アクセス用のシフト数
+ *:::write_pt:出力バッファ用のシフト数
+ */
+void roff_to_buf(cptr str, int maxlen, char *tbuf, size_t bufsize)
+{
+	int read_pt = 0;
+	int write_pt = 0;
+	int line_len = 0;
+	int word_punct = 0;
+	char ch[3];
+	ch[2] = '\0';
+	/*:::\0が読み込まれるまでループする*/
+	while (str[read_pt])
+	{
+#ifdef JP
+		bool kinsoku = FALSE;
+		bool kanji;
+#endif
+		int ch_len = 1;
+
+		/* Prepare one character */
+		/*:::ch[0-2]に一文字代入。ch[0]に8バイト入れてiskanji(ch[0])が0以外ならch[1]にもう8バイト入れる。末尾は\0*/
+		/*:::※（iskanji() shift-jisの1バイト目の字かどうか判定）*/
+		ch[0] = str[read_pt];
+		ch[1] = '\0';
+#ifdef JP
+		kanji  = iskanji(ch[0]);
+
+		if (kanji)
+		{
+			ch[1] = str[read_pt+1];
+			ch_len = 2;
+
+			/*:::文字が日本語で「。/、/ィ/ー」のどれかだとkinsokuをTRUEにしている。*/
+			/*:::改行直後の一文字目がこれらの文字にならないための処理をするフラグと思われる*/
+			if (strcmp(ch, "。") == 0 ||
+			    strcmp(ch, "、") == 0 ||
+			    strcmp(ch, "ィ") == 0 ||
+			    strcmp(ch, "ー") == 0)
+				kinsoku = TRUE;
+		}
+		/*:::文字が表示可能文字でない場合は半角スペースに置き換える*/
+		/*:::※（isprint() 文字が表示文字だったら真を返す）*/
+		else if (!isprint(ch[0]))
+			ch[0] = ' ';
+#else
+		if (!isprint(ch[0]))
+			ch[0] = ' ';
+#endif
+		/*:::今扱っている一文字でmaxlenを超える||今読み込んだ文字が\nの場合に改行処理に移る*/
+		if (line_len + ch_len > maxlen - 1 || str[read_pt] == '\n')
+		{
+			int word_len;
+
+			/* return to better wrapping point. */
+			/* Space character at the end of the line need not to be printed. */
+			word_len = read_pt - word_punct;
+#ifdef JP
+			/*:::kinsokuでない日本語なら何もしない*/
+			if (kanji && !kinsoku)
+				/* nothing */ ;
+			else
+#endif
+			/*:::半角空白もしくは単語の長さが長すぎるならread_ptを1バイト加算*/
+			if (ch[0] == ' ' || word_len >= line_len/2)
+				read_pt++;
+			/*:::それ以外の文字なら単語の巻き戻し処理。*/
+			/*:::read_ptとwrite_ptを最後の区切り文字まで戻している？*/
+			else
+			{
+				read_pt = word_punct;
+				if (str[word_punct] == ' ')
+					read_pt++;
+				write_pt -= word_len;
+			}
+			/*:::出力部に\0を書き込んで行末処理、行カウントリセット、ループ続行*/
+			tbuf[write_pt++] = '\0';
+			line_len = 0;
+			word_punct = read_pt;
+			continue;
+		}
+		/*:::今読んだ文字が半角スペースなら区切り文字としてword_punctを移動*/
+		if (ch[0] == ' ')
+			word_punct = read_pt;
+#ifdef JP
+		/*:::今の文字がkinsoku日本語以外なら区切り文字としてword_punctを移動*/
+		/*:::なんかここバグな気がする。これでは普通の半角文字も対象になって英文を扱ったとき単語が切れるのではないか。*/
+		if (!kinsoku) word_punct = read_pt;
+#endif
+
+		/* Not enough buffer size */
+		/*:::バッファが足りなくなったらループから脱出し途中で終了。そこまでの出力はされる*/
+		if ((size_t)(write_pt + 3) >= bufsize) break;
+
+		/*:::tbufに文字を1バイト書き込む。各変数を加算する。*/
+		tbuf[write_pt++] = ch[0];
+		line_len++;
+		read_pt++;
+#ifdef JP
+		/*:::日本語ならtbufにさらに1バイト書き込む。*/
+		if (kanji)
+		{
+			tbuf[write_pt++] = ch[1];
+			line_len++;
+			read_pt++;
+		}
+#endif
+	}
+	/*:::最後にtbuf[]の末尾を2バイト分\0にする*/
+	tbuf[write_pt] = '\0';
+	tbuf[write_pt+1] = '\0';
+
+	return;
+}
+
+
+/*
+ * The my_strcpy() function copies up to 'bufsize'-1 characters from 'src'
+ * to 'buf' and NUL-terminates the result.  The 'buf' and 'src' strings may
+ * not overlap.
+ *
+ * my_strcpy() returns strlen(src).  This makes checking for truncation
+ * easy.  Example: if (my_strcpy(buf, src, sizeof(buf)) >= sizeof(buf)) ...;
+ *
+ * This function should be equivalent to the strlcpy() function in BSD.
+ */
+size_t my_strcpy(char *buf, const char *src, size_t bufsize)
+{
+#ifdef JP
+
+	char *d = buf;
+	const char *s = src;
+	size_t len = 0;
+
+	if (bufsize > 0) {
+		/* reserve for NUL termination */
+		bufsize--;
+
+		/* Copy as many bytes as will fit */
+		while (*s && (len < bufsize))
+		{
+			if (iskanji(*s))
+			{
+				if (len + 1 >= bufsize || !*(s+1)) break;
+				*d++ = *s++;
+				*d++ = *s++;
+				len += 2;
+			}
+			else
+			{
+				*d++ = *s++;
+				len++;
+			}
+		}
+		*d = '\0';
+	}
+
+	while(*s++) len++;
+
+	return len;
+
+#else
+
+	size_t len = strlen(src);
+	size_t ret = len;
+
+	/* Paranoia */
+	if (bufsize == 0) return ret;
+
+	/* Truncate */
+	if (len >= bufsize) len = bufsize - 1;
+
+	/* Copy the string and terminate it */
+	(void)memcpy(buf, src, len);
+	buf[len] = '\0';
+
+	/* Return strlen(src) */
+	return ret;
+
+#endif
+}
+
+
+/*
+ * The my_strcat() tries to append a string to an existing NUL-terminated string.
+ * It never writes more characters into the buffer than indicated by 'bufsize' and
+ * NUL-terminates the buffer.  The 'buf' and 'src' strings may not overlap.
+ *
+ * my_strcat() returns strlen(buf) + strlen(src).  This makes checking for
+ * truncation easy.  Example:
+ * if (my_strcat(buf, src, sizeof(buf)) >= sizeof(buf)) ...;
+ *
+ * This function should be equivalent to the strlcat() function in BSD.
+ */
+size_t my_strcat(char *buf, const char *src, size_t bufsize)
+{
+	size_t dlen = strlen(buf);
+
+	/* Is there room left in the buffer? */
+	if (dlen < bufsize - 1)
+	{
+		/* Append as much as possible  */
+		return (dlen + my_strcpy(buf + dlen, src, bufsize - dlen));
+	}
+	else
+	{
+		/* Return without appending */
+		return (dlen + strlen(src));
+	}
+}
+
+
+/*
+ * A copy of ANSI strstr()
+ *
+ * my_strstr() can handle Kanji strings correctly.
+ */
+char *my_strstr(const char *haystack, const char *needle)
+{
+	int i;
+	int l1 = strlen(haystack);
+	int l2 = strlen(needle);
+
+	if (l1 >= l2)
+	{
+		for(i = 0; i <= l1 - l2; i++)
+		{
+			if(!strncmp(haystack + i, needle, l2))
+				return (char *)haystack + i;
+
+#ifdef JP
+			if (iskanji(*(haystack + i))) i++;
+#endif
+		}
+	}
+
+	return NULL;
+}
+
+
+/*
+ * A copy of ANSI strchr()
+ *
+ * my_strchr() can handle Kanji strings correctly.
+ */
+	/*:::文字列のポインタを指定文字まで進める（漢字対応）　のだと思う*/
+char *my_strchr(const char *ptr, char ch)
+{
+	for ( ; *ptr != '\0'; ptr++)
+	{
+		if (*ptr == ch) return (char *)ptr;
+
+#ifdef JP
+		if (iskanji(*ptr)) ptr++;
+#endif
+	}
+
+	return NULL;
+}
