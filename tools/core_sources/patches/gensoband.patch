+/*
+ * Convert string to lower case
+ */
+/*:::文字列を何か機種依存関係の調整してる？詳細不明*/
+void str_tolower(char *str)
+{
+	/* Force to be lower case string */
+	for (; *str; str++)
+	{
+#ifdef JP
+		if (iskanji(*str))
+		{
+			str++;
+			continue;
+		}
+#endif
+		*str = tolower(*str);
+	}
+}
