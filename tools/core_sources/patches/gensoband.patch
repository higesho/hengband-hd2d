+
+/*
+ * Hack -- describe the given monster race in the current "term" window
+ */
+/*:::モンスターの思い出を表示する*/
+void display_roff(int r_idx)
+{
+	int y;
+
+	/* Erase the window */
+	for (y = 0; y < Term->hgt; y++)
+	{
+		/* Erase the line */
+		Term_erase(0, y, 255);
+	}
+
+	/* Begin recall */
+	Term_gotoxy(0, 1);
+
+	hook_c_roff = c_roff;
+
+	/* Recall monster */
+	roff_aux(r_idx, 0);
+
+	/* Describe monster */
+	roff_top(r_idx);
+}
