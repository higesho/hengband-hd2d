+void pause_line(int row)
+{
+	prt("", row, 0);
+#ifdef JP
+	put_str("[ 何かキーを押して下さい ]", row, 26);
+#else
+	put_str("[Press any key to continue]", row, 23);
+#endif
+
+	(void)inkey();
+	prt("", row, 0);
+}
