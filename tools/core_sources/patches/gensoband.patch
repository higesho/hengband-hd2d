+		/* Unlock it, Ignore errors */
+		lockf(fd, F_ULOCK, 0);
+	}
+
+	/* Lock */
+	else
+	{
+		/* Lock the score file */
+		if (lockf(fd, F_LOCK, 0) != 0) return (1);
+	}
+
+#  endif
+
+# else
+
+#  if defined(LOCK_UN) && defined(LOCK_EX)
+
+	/* Un-Lock */
+	if (what == F_UNLCK)
+	{
+		/* Unlock it, Ignore errors */
+		(void)flock(fd, LOCK_UN);
+	}
+
+	/* Lock */
+	else
+	{
+		/* Lock the score file */
+		if (flock(fd, LOCK_EX) != 0) return (1);
+	}
+
+#  endif
+
+# endif
+
+#endif
+
+	/* Success */
+	return (0);
+}
