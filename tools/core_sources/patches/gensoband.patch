+/*
+ * Dimension Door
+ */
+///mod140527 動作モードを設定するようにした
+//成功した時TRUE,失敗(変な所に飛んだのも含め)はFALSEを返す
+static bool dimension_door_aux(int x, int y, int mode)
+{
+	int	plev = p_ptr->lev;
+
+	//v1.1.13 if/elseが増えすぎたのでswitchに書き換えた
