-#else
-	prt(format("Which dungeon do you %s?: ", note), 0, 0);
-#endif
-	while(1)
-	{
-		i = inkey();
-		if ((i == ESCAPE) || !num)
-		{
-			/* Free the "dun" array */
-			C_KILL(dun, max_d_idx, s16b);
-
-			screen_load();
-			return 0;
-		}
-		if (i >= 'a' && i <('a'+num))
-		{
-			select_dungeon = dun[i-'a'];
-			break;
-		}
-		else bell();
-	}
-	screen_load();
-
-	/* Free the "dun" array */
-	C_KILL(dun, max_d_idx, s16b);
-
-	return select_dungeon;
-}
