+#ifdef ALLOW_REPEAT /* TNB */
+
+#define REPEAT_MAX		20
+
+/* Number of chars saved */
+static int repeat__cnt = 0;
+
+/* Current index */
+static int repeat__idx = 0;
+
+/* Saved "stuff" */
+static int repeat__key[REPEAT_MAX];
+
+/*:::repeat__key[repeat__cnt++]にwhatを登録する。repeat__idxも加算する。なぜ分けてるのか不明*/
+void repeat_push(int what)
+{
+	/* Too many keys */
+	if (repeat__cnt == REPEAT_MAX) return;
+
+	/* Push the "stuff" */
+	repeat__key[repeat__cnt++] = what;
+
+	/* Prevents us from pulling keys */
+	++repeat__idx;
+}
+
+/*:::repeat__key[repeat__idx]にキーが登録されていればそれをwhatに格納しTRUEを返す*/
+
+bool repeat_pull(int *what)
+{
+	/* All out of keys */
+	if (repeat__idx == repeat__cnt) return (FALSE);
+
+	/* Grab the next key, advance */
+	*what = repeat__key[repeat__idx++];
+
+	/* Success */
+	return (TRUE);
+}
+
+/*:::コマンドが'n'のとき、前回のコマンドを持ってきてcommand_cmdに入れる。そうでないときコマンドを次のリピート用に登録する。*/
+void repeat_check(void)
+{
+	int		what;
+
+	/* Ignore some commands */
+	if (command_cmd == ESCAPE) return;
+	if (command_cmd == ' ') return;
+	if (command_cmd == '\r') return;
+	if (command_cmd == '\n') return;
+
+	//v1.1.36 リピートフラグ
+	command_repeat_flag = FALSE;
+
+	/* Repeat Last Command */
+	if (command_cmd == 'n')
+	{
+		/* Reset */
+		repeat__idx = 0;
+
+		/* Get the command */
+		if (repeat_pull(&what))
+		{
+			/* Save the command */
+			command_cmd = what;
+			//v1.1.36 リピートフラグ
+			command_repeat_flag = TRUE;
+		}
+	}
+
+	/* Start saving new command */
+	else
+	{
+		/* Reset */
+		repeat__cnt = 0;
+		repeat__idx = 0;
+
+		what = command_cmd;
+
+		/* Save this command */
+		repeat_push(what);
+	}
+}
+
+#endif /* ALLOW_REPEAT -- TNB */
