-		default:
-		{
-			/* Insert a character */
-
-			char tmp[100];
-			char c;
-
-			/* Ignore special keys */
-			if (skey & SKEY_MASK) break;
-
-			/* Get a character code */
-			c = (char)skey;
-
-			if (color == TERM_YELLOW)
-			{
-				/* Overwrite default string */
