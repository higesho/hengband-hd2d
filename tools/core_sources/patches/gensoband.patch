-#ifdef JP
-			if (iskanji(c))
-			{
-				char next;
-
-				/* Bypass macro processing */
-				inkey_base = TRUE;
-				next = inkey();
-
-				if (pos + 1 < len)
-				{
-					buf[pos++] = c;
-					buf[pos++] = next;
-				}
-				else
-				{
-					bell();
-				}
-			}
-			else
-#endif
-			{
-#ifdef JP
-				if (pos < len && (isprint(c) || iskana(c)))
-#else
-				if (pos < len && isprint(c))
-#endif
-				{
-					buf[pos++] = c;
-				}
-				else
-				{
-					bell();
-				}
-			}
-
-			/* Terminate */
-			buf[pos] = '\0';
-
-			/* Write back the left part of string */
-			my_strcat(buf, tmp, len + 1);
-
-			break;
-		} /* default: */
-
-		}
