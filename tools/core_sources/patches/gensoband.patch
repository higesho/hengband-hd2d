+/*
+ * Prepare hook for c_roff(). It will be changed for spoiler generation in wizard1.c.
+ */
+void (*hook_c_roff)(byte attr, cptr str) = c_roff;
+
+static void hooked_roff(cptr str)
+{
+	/* Spawn */
+	hook_c_roff(TERM_WHITE, str);
+}
