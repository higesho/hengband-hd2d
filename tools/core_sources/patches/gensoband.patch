+	if (	p_ptr->pclass == CLASS_KOMACHI && p_ptr->lev > 29
+		||	IS_METAMORPHOSIS && r_info[MON_EXTRA_FIELD].flags2 & RFR_RES_TELE
+		||	p_ptr->resist_time && p_ptr->lev > randint1(100))
