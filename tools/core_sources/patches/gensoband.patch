-static bool check_hostile_align(byte sub_align1, byte sub_align2)
-{
-
-	//v1.1.91 クエストダンジョンで複数勢力のモンスターが殴り合う用
-	if ((sub_align1 & SUB_ALIGN_QUEST_MASK) && (sub_align1 & SUB_ALIGN_QUEST_MASK))
