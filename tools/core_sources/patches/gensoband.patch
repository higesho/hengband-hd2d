-		if (sub_align1 != sub_align2) return TRUE;
-		else return FALSE;
-	}
-
-	if (sub_align1 != sub_align2)
-	{
-		if (((sub_align1 & SUB_ALIGN_EVIL) && (sub_align2 & SUB_ALIGN_GOOD)) ||
-			((sub_align1 & SUB_ALIGN_GOOD) && (sub_align2 & SUB_ALIGN_EVIL)))
-			return TRUE;
-	}
-
-	/* Non-hostile alignment */
-	return FALSE;
