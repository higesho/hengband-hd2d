+/*
+ * Hack -- describe the given monster race at the top of the screen
+ */
+/*:::メインウィンドウ上部にモンスターの思い出を表示する*/
+void screen_roff(int r_idx, int mode)
+{
+	/* Flush messages */
+	msg_print(NULL);
+
+	/* Begin recall */
+	Term_erase(0, 1, 255);
+
+	hook_c_roff = c_roff;
+
+	/* Recall monster */
+	roff_aux(r_idx, mode);
+
+	/* Describe monster */
+	roff_top(r_idx);
+}
