-		{
-#ifdef JP
-			msg_format("まだ%sに入ったことはない。", d_name + d_info[DUNGEON_ANGBAND].name);
-#else
-			msg_format("You haven't entered %s yet.", d_name + d_info[DUNGEON_ANGBAND].name);
-#endif
-			msg_print(NULL);
-			return 0;
-		}
-	}
-
-	/* Allocate the "dun" array */
-	C_MAKE(dun, max_d_idx, s16b);
-
-	screen_save();
-	for(i = 1; i < max_d_idx; i++)
-	{
-		char buf[80];
