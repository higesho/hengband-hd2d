@@ -207,9 +207,20 @@
  * Basically, SET_UID should *only* be set for "Unix" machines,
  * or for the "Atari" platform which is Unix-like, apparently
  */
+/*
+ * //GB: Android では SET_UID を立てない（2026-08-21。実機で踏んだ）。
+ * Windows は WINDOWS が立つのでもともと外れている。Android は Unix なので
+ * そのままだと立ってしまい、2 つの形で起動が死ぬ:
+ *   1. z-config.h の PRIVATE_USER_PATH "~/.angband" へ ANGBAND_DIR_USER が飛び、
+ *      init2.c:184 が展開できないまま「required directory is missing」で止まる。
+ *   2. util.c の safe_setuid_grab() が setregid を呼び、Android の seccomp が
+ *      SIGSYS でプロセスごと殺す（Sil-Q 側で実測）。
+ * どちらも「Windows と同じ構成」にすれば消える。docs/ANDROID_HD2D_PORT.md 2b.4
+ */
 #if !defined(MACINTOSH) && !defined(WINDOWS) && \
     !defined(MSDOS) && !defined(USE_EMX) && \
-    !defined(AMIGA) && !defined(ACORN) && !defined(VM)
+    !defined(AMIGA) && !defined(ACORN) && !defined(VM) && \
+    !defined(__ANDROID__)
 # define SET_UID
 #endif
 
