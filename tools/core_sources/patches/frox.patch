+/*
+ * FC: #120 Column widths for the summary tables. Widen ONLY in japanese;
+ * the english files must stay byte-identical (design 1, constraint 1).
+ *
+ * In CP932 one full-width char is 2 bytes and 2 columns, so `%-N.Ns`
+ * (which cuts by bytes) doubles as a column count.
+ * Name column 18 bytes (9 chars; the longest is 16 for Doppelganger),
+ * skill column 11 bytes (the longest value is 8).
+ * The widest table is 18+1+11*4+4+5 = 72, inside the 80 the help doc
+ * allocates (z-doc.c:3497).
+ */
+static cptr _col_fmt(int cols)
+{
+    static char buf[8][16];
+    static int  slot = 0;
+    char       *out = buf[(slot++) & 7]; /* two may reach one fprintf */
+    sprintf(out, "%%-%d.%ds", cols, cols);
+    return out;
+}
+static int _name_col(int en_cols) { return fc_lang_enabled() ? 18 : en_cols; }
+static int _skill_col(void) { return fc_lang_enabled() ? 11 : 13; }
+static cptr _col_fmt_nomax(int en_cols)
+{
+    static char buf[4][16];
+    static int  slot = 0;
+    char       *out;
+    if (fc_lang_enabled()) return _col_fmt(_name_col(en_cols));
+    out = buf[(slot++) & 3]; /* english keeps the original, no-precision form */
+    sprintf(out, "%%-%ds", en_cols);
+    return out;
+}
+
+/*
+ * FC: #120 One heading row of a skill table. Column names come from the
+ * `F:` table, not `A:` -- `Perception` is also a spell name and `Save` is
+ * also a menu item, so the shared bare-word table would hit them.
+ */
+static void _skill_header(FILE *fp, int en_name_cols, cptr c1, cptr c2, cptr c3, cptr c4, cptr tail)
+{
+    fprintf(fp, _col_fmt(_name_col(en_name_cols)), "");
+    fputs(" <color:w>", fp);
+    fprintf(fp, _col_fmt(_skill_col()), fc_frame_label(c1));
+    fputc(' ', fp);
+    fprintf(fp, _col_fmt(_skill_col()), fc_frame_label(c2));
+    fputc(' ', fp);
+    fprintf(fp, _col_fmt(_skill_col()), fc_frame_label(c3));
+    fputc(' ', fp);
+    fprintf(fp, _col_fmt(_skill_col()), fc_frame_label(c4));
+    if (tail)
+    {
+        fputc(' ', fp);
+        fputs(fc_frame_label(tail), fp);
+    }
+    fputs("</color>\n", fp);
+}
+
