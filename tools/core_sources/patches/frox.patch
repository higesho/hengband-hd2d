+//FC: japanese monster spell names run up to 30 bytes (= 30 columns) and the name
+//FC: starts in column 0, so it reaches column 30. z-doc.c rolls a <tab:N> back once
+//FC: the cursor passed it, which would eat the tail of the name. The tag cannot move
+//FC: inside the translation (a changed tag is rejected on load), so it rides in as a
+//FC: %s argument and the column is picked here (docs/FROX_JA_DESIGN.md 8.57 #55).
+static cptr _blue_col_num(void) { return fc_lang_enabled() ? "<tab:33>" : "<tab:27>"; } //FC: #55
+static cptr _blue_col_cast(void) { return fc_lang_enabled() ? "<tab:67>" : "<tab:56>"; } //FC: #55
+
 static void _dump(doc_ptr doc)
 {
     monster_race *r_ptr = &r_info[MON_SEXY_SWIMSUIT];
@@ -21,15 +30,15 @@ static void _dump(doc_ptr doc)
     blue_mage_update_parms(spells);
     doc_insert(doc, "<topic:Blue Magic>================================== <color:keypress>B</color>lue Magic =================================\n\n");
 
-    doc_insert(doc, "<color:G><tab:27>Lvl Cost Fail Desc           Cast</color>\n");
+    doc_printf(doc, "<color:G>%sLvl Cost Fail Desc           Cast</color>\n", _blue_col_num()); //FC: #55
 
     for (i = 0; i < vec_length(spells); i++)
     {
         mon_spell_ptr spell = vec_get(spells, i);
         mon_spell_doc(spell, doc);
-        doc_printf(doc, "<tab:27>%3d%5d%4d%%", spell->prob, mon_spell_cost(spell, r_ptr), blue_mage_spell_fail_rate(spell));
+        doc_printf(doc, "%s%3d%5d%4d%%", _blue_col_num(), spell->prob, mon_spell_cost(spell, r_ptr), blue_mage_spell_fail_rate(spell)); //FC: #55
         list_spell_info(doc, spell, r_ptr);
-        doc_printf(doc, "<tab:56>%4d\n", spell->lore);
+        doc_printf(doc, "%s%4d\n", _blue_col_cast(), spell->lore); //FC: #55
     }
     vec_free(spells);
 
