+/*!
+ * @brief 再生: 受け取ったバイト列を Term のセルへ**文字単位で**置く。
+ * @details ワイヤに載ってくるのはバイト列だが、Term のセルは**1 桁**である
+ * （`term/term-char.h`）。全角は「左半分のセルへ文字を丸ごと・右半分は継続」と置き、
+ * 属性に `AF_WIDE1` / `AF_WIDE2` を立てる。**旗を立てないと描画側が桁を数え違える。**
+ * かつては 1 バイト 1 セルだったので `std::copy_n` で流し込めていた。
+ */
+static void playback_put_text(int x, int y, byte col, std::string_view bytes)
+{
+    const auto columns = text::display_width(bytes);
+    if (columns <= 0) {
+        return;
+    }
+
+    update_term_size(x, y, columns);
+    (void)((*angband_terms[0]->text_hook)(x, y, columns, col, bytes));
+
+    auto &row_c = game_term->scr->c[y];
+    auto &row_a = game_term->scr->a[y];
+    const auto width = static_cast<int>(row_c.size());
+    auto cx = x;
+    for (std::size_t pos = 0; pos < bytes.size();) {
+        const auto step = text::char_bytes(bytes, pos);
+        if (step == 0) {
+            break;
+        }
+
+        const auto cw = text::char_columns(bytes, pos);
+        if ((cx + cw) > width) {
+            break;
+        }
+
+        row_c[cx] = TermChar::from_bytes(bytes.substr(pos, step));
+        row_a[cx] = (cw == 2) ? (col | AF_WIDE1) : col;
+        if (cw == 2) {
+            row_c[cx + 1] = TermChar::wide_tail();
+            row_a[cx + 1] = col | AF_WIDE2;
+        }
+
+        cx += cw;
+        pos += step;
+    }
+}
