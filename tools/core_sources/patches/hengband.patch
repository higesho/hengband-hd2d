+// [hengband] How many bytes of a multibyte character start at `c`, in the
+// *literal* encoding, or 0 if this byte should be parsed normally.
+//
+// The書式文字列 may contain Japanese. In Shift-JIS the second byte can be
+// '{' (0x7B) or '}' (0x7D), so those bytes must be skipped rather than parsed.
+// Once the literal encoding becomes UTF-8 the skip width changes (2 -> 3 for
+// kanji), and skipping a fixed 2 bytes both mis-parses the trailing byte and
+// can run past the end of the string.
+FMT_CONSTEXPR int literal_multibyte_length(char c) {
+  const auto ch = static_cast<unsigned char>(c);
+  if (ch < 0x80) return 0;
+  if (const_check(is_utf8_enabled)) {
+    if ((ch & 0xe0) == 0xc0) return 2;
+    if ((ch & 0xf0) == 0xe0) return 3;
+    if ((ch & 0xf8) == 0xf0) return 4;
+    return 1;  // stray continuation byte; step over it
+  }
+  return is_sjis_multibyte_char(c) ? 2 : 0;
