+/*!
+ * @brief 自由文字入力（askfor）の開始／終了を UI 層へ知らせるフック。
+ * @details 既定 nullptr で、設定しなければ何も起きない（`quit_aux` / `plog_aux` と同じ作法）。
+ *
+ * ソフトキーボードしか持たない環境（Android）では、**いま文字を打つ場面なのか**を
+ * UI が知らないとキーボードを出す判断ができない。画面の見た目から推測する手もあるが、
+ * `askfor()` は名前入力・銘の刻印・検索語など**自由文字入力すべての唯一の入口**なので、
+ * ここで直接知らせるのが確実で、推測に伴う誤爆も無い。
+ * @note 実装は `presentation/bridge/presentation_bridge.cpp`
+ * （`presentation::install_text_input_hook`）。
+ */
+extern void (*text_input_state_hook)(bool active);
+
+/*!
+ * @brief `text_input_state_hook` を「入ったら true / 抜けたら false」で必ず呼ぶスコープ。
+ * @details 自由文字入力のループは途中で複数の return を持つので、スコープで縛る。
+ * `askfor()` 以外にも**自前の編集ループを持つ画面**があるので、そこでも同じものを置く：
+ *   - `src/birth/history-editor.cpp`（生い立ちの編集。名前入力の直後に来る）
+ *   - `src/cmd-io/cmd-autopick.cpp`（自動拾いの設定エディタ）
+ * 入れ子は想定しない（自由文字入力の中から自由文字入力は始まらない）。
+ */
+class TextInputScope {
+public:
+    TextInputScope()
+    {
+        if (text_input_state_hook != nullptr) {
+            text_input_state_hook(true);
+        }
+    }
+    ~TextInputScope()
+    {
+        if (text_input_state_hook != nullptr) {
+            text_input_state_hook(false);
+        }
+    }
+    TextInputScope(const TextInputScope &) = delete;
+    TextInputScope &operator=(const TextInputScope &) = delete;
+};
