+ * **fmt の書式検査（`consteval`）が全部落ちる**（実測 190 箇所）。
+ *
+ * 書式文字列は「引数の型と placeholder が合っているか」をコンパイル時に見てもらう値打ちが
+ * 大きい。**捨てずに両方検査する**ために、`fmt::format_string` を 2 本抱えた型を用意する。
+ *
+ * ## 使い分け
+ * ```
+ * msg_print(_F("{}を拾った。", "You have {}."), name);   // ← 書式文字列。両方検査される
+ * msg_format(_("%sを拾った。", "You have %s."), name);   // ← 可変引数。const char * のまま
+ * prt(_("ようこそ", "Welcome"), 1, 2);                   // ← ただの文字列。同上
+ * ```
+ * **`_F()` は fmt の書式文字列を受ける口にだけ使う。**
+ * `format()` / `msg_format()` / `quit_fmt()` は C の可変引数なので、
+ * クラス型を渡すと壊れる（`const char *` を渡す `_()` のままにすること）。
+ *
+ * @note 言語の状態（`is_japanese()` / `set_language()`）は `locale/language-switcher.h` にある。
+ * あちらは `system/angband.h` から木のほぼ全部へ入るので、fmt を持ち込めない。
+ */
+#pragma once
+
+#include "locale/language-switcher.h" //!< `i18n::is_japanese()`（言語の状態はこちらに置いてある）
+
+#include <cstdint>
+#include <cstdio>
+#include <fmt/format.h>
+#include <string>
+#include <type_traits>
+
+namespace i18n {
+
+/*!
+ * @brief 日英ひと組の文字列リテラル。**両方を持ったまま持ち回る。**
+ * @details `consteval` なので、生まれるのは必ずコンパイル時である。
+ * @note **`const char *` への暗黙変換をわざと持たせていない。**
+ * 持たせると `msg_format()` のような C の可変引数へするりと入ってしまい、
+ * 受け側が `char *` として読んで壊れる（気づきにくい形で）。
+ */
+class LocalizedLiteral {
+public:
+    /*!
+     * @brief 既定は**空文字列**（`nullptr` にしない）。
+     * @details 表の要素にするとき、既定構築できないと `menu_content` のような集成体の
+     * 既定コンストラクタが暗黙 delete され、`/Wall` の C4623 に引っかかる。
+     * 中身を `nullptr` にすると読む側が落ちるので、空文字列にしておく。
+     */
+    constexpr LocalizedLiteral() = default;
+
+    consteval LocalizedLiteral(const char *japanese, const char *english)
+        : japanese_(japanese)
+        , english_(english)
+    {
+    }
+
+    constexpr const char *japanese() const noexcept
+    {
+        return this->japanese_;
+    }
+
+    constexpr const char *english() const noexcept
+    {
+        return this->english_;
+    }
+
+    //! いまの言語のほう。
+    const char *get() const noexcept
+    {
+        return is_japanese() ? this->japanese_ : this->english_;
+    }
+
+private:
+    const char *japanese_{ "" };
+    const char *english_{ "" };
+};
+
+/*!
+ * @brief 日英ひと組の書式文字列。**両方をコンパイル時に検査**し、実行時に片方を使う。
+ * @details `fmt::format_string` を 2 本持つだけ。検査はその構築で走るので、
+ * **英語側の placeholder が日本語側と食い違っていればコンパイルが通らない**。
+ * 訳の取り違えが実行時まで残らないのが、この器を作った理由である。
+ */
+template <typename... Args>
+class LocalizedFormatString {
+public:
+    consteval LocalizedFormatString(LocalizedLiteral literal)
+        : japanese_(literal.japanese())
+        , english_(literal.english())
+    {
+    }
+
+    //! 言語に依らない書式（記号だけの行など）はそのまま渡せる。
+    template <size_t N>
+    consteval LocalizedFormatString(const char (&s)[N])
+        : japanese_(s)
+        , english_(s)
+    {
+    }
+
+    fmt::string_view get() const noexcept
+    {
+        return is_japanese() ? this->japanese_.str : this->english_.str;
+    }
+
+private:
+    fmt::format_string<Args...> japanese_;
+    fmt::format_string<Args...> english_;
+};
+
+//! `fmt::format()` の日英版。書式以外の扱いは fmt と同じ。
+template <typename... Args>
+std::string format(LocalizedFormatString<std::type_identity_t<Args>...> format_string, Args &&...args)
+{
+    return fmt::vformat(format_string.get(), fmt::make_format_args(args...));
+}
+
+/*!
+ * @brief `fmt::print()` の日英版。
+ * @details `fmt::print()` は `use_utf8` が偽のとき `vprint_mojibake` を通るが、
+ * この木では `FMT_UNICODE` を落としていないので常に真である（`fmt/base.h` の
+ * `static_assert(!FMT_UNICODE || use_utf8)`）。よって `vprint()` を直に呼んでよい。
+ */
+template <typename... Args>
+void print(std::FILE *file, LocalizedFormatString<std::type_identity_t<Args>...> format_string, Args &&...args)
+{
+    fmt::vprint(file, format_string.get(), fmt::make_format_args(args...));
+}
+
+//! `fmt::println()` の日英版。
+template <typename... Args>
+void println(std::FILE *file, LocalizedFormatString<std::type_identity_t<Args>...> format_string, Args &&...args)
+{
+    fmt::vprintln(file, format_string.get(), fmt::make_format_args(args...));
+}
+
+} // namespace i18n
+
+/*!
+ * @brief 日英ひと組の書式文字列を作る。**fmt の口にだけ使う。**
+ * @details `_()` との違いは「両方を実行時まで持ち回る」こと。
+ * C の可変引数（`format()` / `msg_format()` / `quit_fmt()`）には渡せない。
+ */
+#define _F(JAPANESE, ENGLISH) (::i18n::LocalizedLiteral((JAPANESE), (ENGLISH)))
+
+/*!
+ * @brief 日英ひと組の**文字列**を作る（`_F()` と同じ型。使い所が違うだけ）。
+ * @details `constexpr` の表に入れるためのもの。`_()` は実行時に選ぶ形へ移す予定だが、
+ * **名前空間スコープの表は `set_language()` より先に初期化される**ので、
+ * `_()` を実行時化しても間に合わない。**表の側が日英ひと組を持つ**必要がある。
+ * 読むときに `get()` で選ぶ。
+ */
+#define _L(JAPANESE, ENGLISH) (::i18n::LocalizedLiteral((JAPANESE), (ENGLISH)))
