+/*!
+ * @file localized-table.h
+ * @brief 名前空間スコープの表を、**言語が変わったら組み直す**器。
+ *
+ * ## なぜ要るか
+ * `_()` は実行時に選ぶようになったが、**名前空間スコープの表は `set_language()` より
+ * 先に初期化される**（動的初期化は `main` より前）。そのままだと既定の日本語で凍り、
+ * しかも**コンパイルは通る**ので、エラーでは見つからない。木には 71 枚あった。
+ *
+ * この器は中身を遅らせて持ち、読まれたときの言語と食い違っていれば組み直す。
+ * 遊んでいる途中の切り替え（画面から来る `ui_state.lang`）にも追随する。
+ *
+ * ## 使い方
+ * ```
+ * // 表の中身はそのまま関数へ移す
+ * static std::vector<Foo> build_foos()
+ * {
+ *     return { { _("名", "Name") }, ... };
+ * }
+ * const i18n::LocalizedTable<std::vector<Foo>> foos(build_foos);
+ * ```
+ * 読む側は**元の表と同じに書ける**（範囲 for・`[]`・`.at()`・`.size()`・
+ * `const T &` への暗黙変換）。header の `extern` は
+ * `extern const i18n::LocalizedTable<std::vector<Foo>> foos;` になる。
+ *
+ * @note 1 本の糸で回すゲームなので、組み直しに鍵は掛けていない。
+ */
+#pragma once
+
+#include "locale/language-switcher.h"
+
+#include <type_traits>
+
+namespace i18n {
+
+template <typename T>
+class LocalizedTable {
+public:
+    using Builder = T (*)();
+
+    //! @details `const std::unordered_map<...>` のような**const が付いた別名**で使われることがある。
+    //! 中身は組み直すので、持つほうの const は外しておく。
+    using Value = std::remove_const_t<T>;
+
+    /*!
+     * @param build 表を組む関数。**捕捉のないもの**（関数ポインタ）にすること。
+     * @details `constexpr` なので、この器そのものは定数初期化される
+     * （＝他の翻訳単位の動的初期化と順を争わない）。中身は最初に読まれたときに組む。
+     */
+    constexpr explicit LocalizedTable(Builder build)
+        : build_(build)
+    {
+    }
+
+    //! @details 表は 1 か所に居座るもの。写しは要らない（`/Wall` の C4626 / C5027 も黙る）。
+    LocalizedTable(const LocalizedTable &) = delete;
+    LocalizedTable(LocalizedTable &&) = delete;
+    LocalizedTable &operator=(const LocalizedTable &) = delete;
+    LocalizedTable &operator=(LocalizedTable &&) = delete;
+    ~LocalizedTable() = default;
+
+    //! いまの言語の表。古ければここで組み直す。
+    const T &get() const
+    {
+        if (this->generation_ != language_generation()) {
+            this->value_ = this->build_();
+            this->generation_ = language_generation();
+        }
+
+        return this->value_;
+    }
+
+    operator const T &() const
+    {
+        return this->get();
+    }
+
+    const T *operator->() const
+    {
+        return &this->get();
+    }
+
+    auto begin() const
+    {
+        return this->get().begin();
+    }
+
+    auto end() const
+    {
+        return this->get().end();
+    }
+
+    auto cbegin() const
+    {
+        return this->get().cbegin();
+    }
+
+    auto cend() const
+    {
+        return this->get().cend();
+    }
+
+    auto size() const
+    {
+        return this->get().size();
+    }
+
+    auto empty() const
+    {
+        return this->get().empty();
+    }
+
+    template <typename K>
+    decltype(auto) operator[](const K &key) const
+    {
+        return this->get()[key];
+    }
+
+    template <typename K>
+    decltype(auto) at(const K &key) const
+    {
+        return this->get().at(key);
+    }
+
+    template <typename K>
+    auto find(const K &key) const
+    {
+        return this->get().find(key);
+    }
+
+    template <typename K>
+    auto count(const K &key) const
+    {
+        return this->get().count(key);
+    }
+
+    template <typename K>
+    bool contains(const K &key) const
+    {
+        return this->get().contains(key);
+    }
+
+private:
+    Builder build_;
+    mutable Value value_{};
+    //! @details 既定は `-1`。`language_generation()` の初期値 `0` と必ず食い違うので、最初の読みで組む。
+    mutable int generation_ = -1;
+};
+
+} // namespace i18n
