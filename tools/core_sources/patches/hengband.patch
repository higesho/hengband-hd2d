+/*!
+ * @brief 世界を 1 刻みだけ進める（設計書 §7）
+ * @details `process_dungeon` の周回から**モンスターと世界の分だけ**を取り出したもの。
+ * 中身の並びは本体と同じにしてある——並びを変えると、小窓を開いているときと
+ * 開いていないときで世界の進み方が違うことになる。
+ * @attention 描き直しは呼び出し側の責任。小窓は `screen_save` で下の画面を退避しているので、
+ * ここで地図に描いたものは小窓を閉じたときの `screen_load` で消える。そのため
+ * **地図の描き直しを予約しておく**（これが無いと、閉じた後の地図が古いままになる）。
+ */
+bool advance_world_one_tick(PlayerType *player_ptr)
+{
+    auto &world = AngbandWorld::get_instance();
+    if (!player_ptr->playing || player_ptr->is_dead || player_ptr->leaving) {
+        return false;
+    }
+
+    process_monsters(player_ptr);
+    handle_stuff(player_ptr);
+    if (!player_ptr->playing || player_ptr->is_dead || player_ptr->leaving) {
+        return false;
+    }
+
+    WorldTurnProcessor(player_ptr).process_world();
+    handle_stuff(player_ptr);
+    if (!player_ptr->playing || player_ptr->is_dead || player_ptr->leaving) {
+        return false;
+    }
+
+    world.game_turn++;
+    if (world.dungeon_turn < world.dungeon_turn_limit) {
+        const auto is_wild_mode = world.is_wild_mode();
+        if (!is_wild_mode || wild_regen) {
+            world.dungeon_turn++;
+        } else if (is_wild_mode && !(world.game_turn % ((MAX_HGT + MAX_WID) / 2))) {
+            world.dungeon_turn++;
+        }
+    }
+
+    prevent_turn_overflow(player_ptr);
+    if (wild_regen) {
+        wild_regen--;
+    }
+
+    // 小窓を閉じたとき、退避された古い地図が戻ってこないように。
+    RedrawingFlagsUpdater::get_instance().set_flag(MainWindowRedrawingFlag::MAP);
+    return player_ptr->playing && !player_ptr->is_dead && !player_ptr->leaving;
+}
