index 0000000..25a5a9d
--- /dev/null
+++ b/src/term/term-char.h
@@ -0,0 +1,126 @@
+/*!
+ * @file term-char.h
+ * @brief 端末の 1 桁ぶんの中身。**文字を丸ごと持つ**（バイト 1 個ではない）。
+ *
+ * ## なぜ要るか
+ * `z-term` は長らく **1 セル 1 バイト**で画面を持ち、全角は
+ * 「1 バイト目のセル」と「2 バイト目のセル」の 2 枚に分けて入れていた
+ * （属性の `AF_KANJI1` / `AF_KANJI2` がその目印）。SJIS も EUC も全角が
+ * ちょうど 2 バイト 2 桁なので、これで桁とバイトが一致していた。
+ *
+ * **UTF-8 の漢字は 3 バイトで 2 桁。この器には入らない。**
+ * かといってセルを 3 枚にすると、こんどは桁が合わなくなる。
+ *
+ * ## この型の役目
+ * **セル＝1 桁**は動かさず、**セルの中身のほうを可変長にする**。
+ * 全角は「先頭のセルが文字を丸ごと持ち、右隣のセルは継続の目印」になる
+ * （`wide_tail()`）。こうすると桁の計算は今までどおりで、バイト数だけが
+ * 符号化しだいで変わる。
+ *
+ * 中身は**内部の符号化のまま**（いまは SJIS / EUC、切り替え後は UTF-8）。
+ * 何バイトで何桁かは `locale/text-encoding.h` が答える。
+ *
+ * @note タイル（`AF_TILE1`）のセルは文字ではなく**タイル番号 1 バイト**が入る。
+ * その桁数を `columns()` に聞いてはいけない（文字として測ってしまう）。
+ */
+#pragma once
+
+#include "locale/text-encoding.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+class TermChar {
+public:
+    //! 1 文字が取りうる最大バイト数（UTF-8 の 4 バイト）。
+    static constexpr std::size_t MAX_BYTES = 4;
+
+    /*!
+     * @brief 既定は **NUL 1 バイト**。
+     * @details 昔の `std::vector<char>(w)` によるゼロ初期化と同じ中身にしてある。
+     * 「継続セル」は別物なので `wide_tail()` を使うこと。
+     */
+    constexpr TermChar() = default;
+
+    //! 1 バイトの文字（ASCII）またはタイル番号。**暗黙**にしてあるのは呼び出し側を変えないため。
+    constexpr TermChar(char c)
+        : bytes_{ { c, '\0', '\0', '\0' } }
+        , len_(1)
+    {
+    }
+
+    //! 全角の**右半分**（中身を持たない継続セル）。
+    static constexpr TermChar wide_tail()
+    {
+        TermChar tc;
+        tc.len_ = 0;
+        return tc;
+    }
+
+    //! 1 文字ぶんのバイト列から作る。`MAX_BYTES` を超える分は落とす。
+    static TermChar from_bytes(std::string_view sv)
+    {
+        TermChar tc;
+        tc.len_ = static_cast<std::uint8_t>((sv.size() < MAX_BYTES) ? sv.size() : MAX_BYTES);
+        for (std::size_t i = 0; i < static_cast<std::size_t>(tc.len_); ++i) {
+            tc.bytes_[i] = sv[i];
+        }
+        return tc;
+    }
+
+    //! 中身のバイト列。継続セルは空。
+    constexpr std::string_view view() const
+    {
+        return { this->bytes_.data(), this->len_ };
+    }
+
+    //! 先頭バイト。タイル番号や ASCII の比較に使う。継続セルは `'\0'`。
+    constexpr char lead() const
+    {
+        return (this->len_ > 0) ? this->bytes_[0] : '\0';
+    }
+
+    constexpr std::size_t size() const
+    {
+        return this->len_;
+    }
+
+    //! 継続セル（全角の右半分）か。
+    constexpr bool is_wide_tail() const
+    {
+        return this->len_ == 0;
+    }
+
+    /*!
+     * @brief この文字の表示桁数（継続セルは 0）。
+     * @note タイルのセルに聞いてはいけない（文字として測ってしまう）。
+     */
+    int columns() const
+    {
+        return (this->len_ == 0) ? 0 : text::char_columns(this->view(), 0);
+    }
+
+    constexpr bool operator==(const TermChar &other) const
+    {
+        if (this->len_ != other.len_) {
+            return false;
+        }
+        for (std::size_t i = 0; i < static_cast<std::size_t>(this->len_); ++i) {
+            if (this->bytes_[i] != other.bytes_[i]) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    constexpr bool operator!=(const TermChar &other) const
+    {
+        return !(*this == other);
+    }
+
+private:
+    std::array<char, MAX_BYTES> bytes_{};
+    std::uint8_t len_{ 1 };
+};
