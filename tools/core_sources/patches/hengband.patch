@@ -0,0 +1,448 @@
+/*!
+ * @file text-encoding.cpp
+ * @brief 文字のバイト数と表示桁数。設計の理由は `text-encoding.h` に書いてある。
+ */
+#include "locale/text-encoding.h"
+
+#include "system/h-basic.h"
+
+#include <algorithm>
+#include <string>
+
+namespace text {
+
+namespace utf8 {
+
+/*!
+ * @brief UTF-8 の 1 バイト目から、その文字のバイト数を出す。
+ * @details 内部が UTF-8 になったときのための道。**いまは使われない**
+ * （`JP` のときは SJIS / EUC で答えるため）が、切り替えを 1 行で済ませるために
+ * 先に書いておく。壊れた並びは 1 バイト扱いにして先へ進める。
+ */
+std::size_t bytes_from_lead(unsigned char lead)
+{
+    if (lead < 0x80) {
+        return 1;
+    }
+    if ((lead & 0xe0) == 0xc0) {
+        return 2;
+    }
+    if ((lead & 0xf0) == 0xe0) {
+        return 3;
+    }
+    if ((lead & 0xf8) == 0xf0) {
+        return 4;
+    }
+    return 1; //!< 継続バイトや不正な先頭。止まらせない
+}
+
+/*!
+ * @brief UTF-8 の符号位置が全角か。
+ * @details 東アジアの全角（CJK・かな・全角記号・ハングル）を 2 桁とする。
+ * キリル・ギリシャ・ラテン拡張は**2 バイトだが 1 桁**——ここが SJIS と決定的に違う。
+ */
+bool utf8_is_wide(char32_t cp)
+{
+    return ((cp >= 0x1100) && (cp <= 0x115f)) // ハングル字母
+        || ((cp >= 0x2e80) && (cp <= 0x303e)) // CJK 部首・記号
+        || ((cp >= 0x3041) && (cp <= 0x33ff)) // かな・注音・ハングル互換・囲み
+        || ((cp >= 0x3400) && (cp <= 0x4dbf)) // CJK 拡張 A
+        || ((cp >= 0x4e00) && (cp <= 0x9fff)) // CJK 統合漢字
+        || ((cp >= 0xa000) && (cp <= 0xa4cf)) // イ文字
+        || ((cp >= 0xac00) && (cp <= 0xd7a3)) // ハングル音節
+        || ((cp >= 0xf900) && (cp <= 0xfaff)) // CJK 互換漢字
+        || ((cp >= 0xfe30) && (cp <= 0xfe6f)) // CJK 互換形・小字形
+        || ((cp >= 0xff00) && (cp <= 0xff60)) // 全角英数・記号
+        || ((cp >= 0xffe0) && (cp <= 0xffe6)) // 全角通貨記号
+        || ((cp >= 0x20000) && (cp <= 0x3fffd)); // CJK 拡張 B 以降
+}
+
+char32_t utf8_codepoint(std::string_view str, std::size_t pos, std::size_t len)
+{
+    const auto at = [&](std::size_t i) { return static_cast<unsigned char>(str[pos + i]); };
+    switch (len) {
+    case 2:
+        return static_cast<char32_t>(((at(0) & 0x1f) << 6) | (at(1) & 0x3f));
+    case 3:
+        return static_cast<char32_t>(((at(0) & 0x0f) << 12) | ((at(1) & 0x3f) << 6) | (at(2) & 0x3f));
+    case 4:
+        return static_cast<char32_t>(((at(0) & 0x07) << 18) | ((at(1) & 0x3f) << 12)
+            | ((at(2) & 0x3f) << 6) | (at(3) & 0x3f));
+    default:
+        return static_cast<char32_t>(at(0));
+    }
+}
+
+std::size_t char_bytes(std::string_view str, std::size_t pos)
+{
+    if (pos >= str.size()) {
+        return 0;
+    }
+    //! 末尾で切れていたら残りだけ返す（範囲の外を読ませない）。
+    return std::min(bytes_from_lead(static_cast<unsigned char>(str[pos])), str.size() - pos);
+}
+
+int char_columns(std::string_view str, std::size_t pos)
+{
+    const auto len = char_bytes(str, pos);
+    if (len == 0) {
+        return 0;
+    }
+    return utf8_is_wide(utf8_codepoint(str, pos, len)) ? 2 : 1;
+}
+
+int display_width(std::string_view str)
+{
+    int width = 0;
+    std::size_t pos = 0;
+    while (pos < str.size()) {
+        width += char_columns(str, pos);
+        const auto step = char_bytes(str, pos);
+        pos += (step == 0) ? 1 : step;
+    }
+    return width;
+}
+
+} // namespace utf8
+
+namespace {
+
+/*!
+ * @brief 内部の符号化が UTF-8 か。
+ * @details **切り替えるのは build のほう**（`UTF8` を定義する。`SJIS` / `EUC` と排他）。
+ * `if` で分けて `#ifdef` にしないのは、**両方の道を常にコンパイルさせる**ため。
+ * 片方を前処理で消すと、使っていない側が腐っても気づけない（切り替えた瞬間に初めて
+ * 壊れているのが判る、という一番困る形になる）。定数なので最適化で片側は消える。
+ * @note `UTF8` を定義するときは**ソースの実行文字コードも UTF-8 にする**こと
+ * （MSVC の `/execution-charset:utf-8`）。リテラルが SJIS のままだと辻褄が合わない。
+ */
+#if !defined(JP)
+constexpr bool kInternalIsUtf8 = true; //!< 英語版は ASCII のみ＝ UTF-8 の部分集合
+#elif defined(UTF8)
+constexpr bool kInternalIsUtf8 = true;
+#else
+constexpr bool kInternalIsUtf8 = false; //!< SJIS（Windows）／ EUC（Unix）
+#endif
+
+//! SJIS / EUC で、この 1 バイト目から始まる文字のバイト数。
+std::size_t legacy_bytes(std::string_view str, std::size_t pos)
+{
+#ifdef JP
+    const auto lead = static_cast<unsigned char>(str[pos]);
+    //! 末尾で切れていたら 1 バイト扱いにする（範囲の外を読ませない）。
+    if (iskanji(lead) && ((pos + 1) < str.size())) {
+        return 2;
+    }
+#else
+    (void)str;
+    (void)pos;
+#endif
+    return 1;
+}
+
+} // namespace
+
+std::size_t char_bytes(std::string_view str, std::size_t pos)
+{
+    if (pos >= str.size()) {
+        return 0;
+    }
+    if (kInternalIsUtf8) {
+        return utf8::char_bytes(str, pos);
+    }
+    return legacy_bytes(str, pos);
+}
+
+std::size_t bytes_from_lead(unsigned char lead)
+{
+    if (kInternalIsUtf8) {
+        return utf8::bytes_from_lead(lead);
+    }
+#ifdef JP
+    if (iskanji(lead)) {
+        return 2;
+    }
+#endif
+    return 1;
+}
+
+std::size_t char_bytes(const char *str)
+{
+    if ((str == nullptr) || (*str == '\0')) {
+        return 0;
+    }
+    std::size_t want = 1;
+    if (kInternalIsUtf8) {
+        want = utf8::bytes_from_lead(static_cast<unsigned char>(*str));
+    } else {
+#ifdef JP
+        if (iskanji(static_cast<unsigned char>(*str))) {
+            want = 2;
+        }
+#endif
+    }
+    //! NUL で切れていたらそこまで（範囲の外を読ませない）。
+    for (std::size_t i = 1; i < want; ++i) {
+        if (str[i] == '\0') {
+            return i;
+        }
+    }
+    return want;
+}
+
+int char_columns(std::string_view str, std::size_t pos)
+{
+    const auto len = char_bytes(str, pos);
+    if (len == 0) {
+        return 0;
+    }
+    if (kInternalIsUtf8) {
+        //! **バイト数では決まらない。**キリル文字は 2 バイトだが 1 桁である。
+        return utf8::char_columns(str, pos);
+    }
+    //! SJIS / EUC は**2 バイト＝2 桁**。半角カナ（SJIS の 1 バイト）は 1 桁。
+    return (len >= 2) ? 2 : 1;
+}
+
+int display_width(std::string_view str)
+{
+    int width = 0;
+    std::size_t pos = 0;
+    while (pos < str.size()) {
+        width += char_columns(str, pos);
+        pos += char_bytes(str, pos);
+    }
+    return width;
+}
+
+std::size_t next_char(std::string_view str, std::size_t pos)
+{
+    if (pos >= str.size()) {
+        return str.size();
+    }
+    return pos + char_bytes(str, pos);
+}
+
+bool is_char_boundary(std::string_view str, std::size_t pos)
+{
+    if ((pos == 0) || (pos >= str.size())) {
+        return true;
+    }
+    if (kInternalIsUtf8) {
+        //! UTF-8 の継続バイトは 10xxxxxx。**先頭から数え直さずに判る。**
+        return (static_cast<unsigned char>(str[pos]) & 0xc0) != 0x80;
+    }
+    /*
+     * SJIS / EUC は**継続バイトを見分けられない**（2 バイト目が 1 バイト目の
+     * 範囲に入りうる）。先頭から送って、`pos` にちょうど乗るかで判る。
+     */
+    std::size_t cur = 0;
+    while (cur < pos) {
+        const auto step = char_bytes(str, cur);
+        cur += (step == 0) ? 1 : step;
+    }
+    return cur == pos;
+}
+
+bool is_wide_char_at(std::string_view str, std::size_t pos)
+{
+    return is_char_boundary(str, pos) && (char_columns(str, pos) == 2);
+}
+
+std::size_t prev_char(std::string_view str, std::size_t pos)
+{
+    if (pos == 0) {
+        return 0;
+    }
+    /*
+     * **先頭から数え直す。**後ろから 1 バイトずつ戻ると、SJIS の 2 バイト目が
+     * たまたま 1 バイト目の範囲に入るため境目を誤る（SJIS の有名な穴）。
+     * 文字列は画面 1 行ぶんの長さなので、数え直しても足りる。
+     */
+    std::size_t last = 0;
+    std::size_t cur = 0;
+    while (cur < pos) {
+        last = cur;
+        const auto step = char_bytes(str, cur);
+        cur += (step == 0) ? 1 : step;
+    }
+    return last;
+}
+
+std::string_view truncate_to_columns(std::string_view str, int columns)
+{
+    if (columns <= 0) {
+        return {};
+    }
+    int used = 0;
+    std::size_t pos = 0;
+    while (pos < str.size()) {
+        const int w = char_columns(str, pos);
+        if ((used + w) > columns) {
+            break; //!< 全角が境目に跨るときは**その文字ごと落とす**（半分は化ける）
+        }
+        used += w;
+        pos += char_bytes(str, pos);
+    }
+    return str.substr(0, pos);
+}
+
+std::string pad_to_columns(std::string_view str, int columns, bool left_align)
+{
+    const auto body = truncate_to_columns(str, columns);
+    const int pad = columns - display_width(body);
+    std::string out;
+    out.reserve(body.size() + static_cast<std::size_t>(pad > 0 ? pad : 0));
+    if (!left_align && (pad > 0)) {
+        out.append(static_cast<std::size_t>(pad), ' ');
+    }
+    out.append(body);
+    if (left_align && (pad > 0)) {
+        out.append(static_cast<std::size_t>(pad), ' ');
+    }
+    return out;
+}
+
+bool self_check(std::string &report)
+{
+    report.clear();
+    const auto fail = [&report](const std::string &what) {
+        if (!report.empty()) {
+            report += " / ";
+        }
+        report += what;
+    };
+
+    //! 半角だけ。バイトと桁が一致する側。
+    if (display_width("abc") != 3) {
+        fail("半角 3 字の桁数が 3 でない");
+    }
+    if (char_bytes("abc", 0) != 1) {
+        fail("半角のバイト数が 1 でない");
+    }
+    if (next_char("abc", 0) != 1) {
+        fail("半角で 1 文字進めない");
+    }
+    if (prev_char("abc", 2) != 1) {
+        fail("半角で 1 文字戻れない");
+    }
+
+    /*
+     * 全角。**この行のリテラルは内部の符号化で組まれる**ので、
+     * SJIS なら 2 バイト・UTF-8 なら 3 バイトになる。どちらでも**桁は 2**。
+     * 桁とバイトを別々に見ていることの確認そのものになっている。
+     */
+    const std::string wide = "あ";
+    if (display_width(wide) != 2) {
+        fail("全角 1 字の桁数が 2 でない");
+    }
+    if (char_bytes(wide, 0) != wide.size()) {
+        fail("全角 1 字のバイト数が文字列長と合わない");
+    }
+    if (next_char(wide, 0) != wide.size()) {
+        fail("全角で 1 文字進めない");
+    }
+
+    /*
+     * **1 バイト目だけで見込むバイト数**（キーボードから 1 バイトずつ受ける所の口）。
+     * 文字列が手元にある `char_bytes()` と、同じ文字については同じ答えでなければ、
+     * 入力の途中で 1 バイト取りこぼす／余計に待つことになる。
+     */
+    if (bytes_from_lead(static_cast<unsigned char>('a')) != 1) {
+        fail("半角の 1 バイト目から見込むバイト数が 1 でない");
+    }
+    if (bytes_from_lead(static_cast<unsigned char>(wide[0])) != wide.size()) {
+        fail("全角の 1 バイト目から見込むバイト数が実際と合わない");
+    }
+
+    const std::string mixed = "あa" + wide;
+    if (display_width(mixed) != 5) {
+        fail("混在の桁数が 5 でない");
+    }
+    //! **全角の途中で戻らないこと**（1 バイト戻すと化ける所）。
+    if (prev_char(mixed, mixed.size()) != (wide.size() + 1)) {
+        fail("混在で最後の全角の頭へ戻れない");
+    }
+
+    /*
+     * 文字の境目。**全角の途中を「境目」と答えてはいけない**
+     * （`iskanji2()` の言い換え。カーソルがそこへ止まると化ける）。
+     */
+    if (!is_char_boundary(mixed, 0) || !is_char_boundary(mixed, wide.size())) {
+        fail("文字の頭を境目と認めない");
+    }
+    if (wide.size() > 1) {
+        for (std::size_t i = 1; i < wide.size(); ++i) {
+            if (is_char_boundary(mixed, i)) {
+                fail("全角の途中を境目と答えている");
+                break;
+            }
+        }
+    }
+    if (!is_char_boundary(mixed, mixed.size())) {
+        fail("末尾を境目と認めない");
+    }
+
+    //! 切り詰め。**全角が境目に跨るならその文字ごと落とす。**
+    if (display_width(truncate_to_columns(mixed, 4)) != 3) {
+        fail("4 桁で切ったのに 3 桁にならない（全角を半分残している）");
+    }
+    if (truncate_to_columns(mixed, 0) != std::string_view{}) {
+        fail("0 桁で空にならない");
+    }
+
+    //! 桁揃え。**バイトではなく桁で埋める。**
+    const auto padded = pad_to_columns(wide, 6);
+    if (display_width(padded) != 6) {
+        fail("桁揃えの結果が 6 桁でない");
+    }
+    if (display_width(pad_to_columns(mixed, 3)) != 3) {
+        fail("溢れた桁揃えが 3 桁に収まっていない");
+    }
+
+    //! 空・範囲外。**落ちないこと。**
+    if ((display_width("") != 0) || (char_bytes("", 0) != 0) || (char_columns("abc", 99) != 0)) {
+        fail("空や範囲外で 0 を返さない");
+    }
+    if (next_char("", 0) != 0) {
+        fail("空で進めようとして壊れる");
+    }
+
+    /*
+     * ここから **UTF-8 の道**（`text::utf8`）。内部がまだ SJIS でも通す。
+     * バイト列を直に書くのは、**この build の実行文字コードに左右されないため**。
+     * 切り替えてから初めて壊れているのが判るのでは遅いので、先に通しておく。
+     */
+    {
+        const std::string_view u_a = "\xe3\x81\x82"; //!< U+3042「あ」= 3 バイト
+        if ((utf8::char_bytes(u_a, 0) != 3) || (utf8::char_columns(u_a, 0) != 2)) {
+            fail("UTF-8: かなが 3 バイト 2 桁にならない");
+        }
+        const std::string_view u_ru = "\xd0\x94"; //!< U+0414「Д」= 2 バイト**だが 1 桁**
+        if ((utf8::char_bytes(u_ru, 0) != 2) || (utf8::char_columns(u_ru, 0) != 1)) {
+            fail("UTF-8: キリル文字が 2 バイト 1 桁にならない（バイト数で桁を決めている）");
+        }
+        const std::string_view u_emoji = "\xf0\x9f\x90\x89"; //!< U+1F409 = 4 バイト
+        if (utf8::char_bytes(u_emoji, 0) != 4) {
+            fail("UTF-8: 4 バイト文字を 4 バイトと数えない");
+        }
+        //! 漢字（3 バイト 2 桁）＋ ラテン（1 バイト 1 桁）＋ キリル（2 バイト 1 桁）
+        const std::string_view u_mixed = "\xe6\xbc\xa2" "a" "\xd0\x94";
+        if (u_mixed.size() != 6) {
+            fail("UTF-8: 検査用の並びが 6 バイトでない");
+        }
+        if (utf8::display_width(u_mixed) != 4) {
+            fail("UTF-8: 6 バイトの並びが 4 桁にならない（バイト＝桁のまま数えている）");
+        }
+        //! 途中で切れた並びで**範囲の外を読まない**こと。
+        if (utf8::char_bytes(u_a.substr(0, 2), 0) != 2) {
+            fail("UTF-8: 切れた並びで残りより多く読もうとする");
+        }
+        if (utf8::display_width("") != 0) {
+            fail("UTF-8: 空が 0 桁にならない");
+        }
+    }
+    return report.empty();
+}
+
+} // namespace text
diff --git a/target/src/locale/text-encoding.h b/src/locale/text-encoding.h
new file mode 100644
index 0000000..b1a8d01
--- /dev/null
+++ b/src/locale/text-encoding.h
@@ -0,0 +1,149 @@
+/*!
+ * @file text-encoding.h
+ * @brief 文字の**バイト数と表示桁数**を、内部の符号化に依らず答える層。
+ *
+ * ## なぜ要るか
+ * このゲームは長らく「**バイト数 ＝ 表示桁数**」で書かれている。SJIS も EUC も
+ * 漢字がちょうど 2 バイトで 2 桁ぶんの幅なので、`strlen()` がそのまま桁数になり、
+ * `iskanji()` で 1 バイト目を見て 2 バイト進めば 1 文字進めた（`system/h-config.h` の
+ * 注記「このゲームが UTF 系の可変長文字列に非対応であるため」）。
+ *
+ * 多言語化ではこの等式が崩れる。UTF-8 の漢字は **3 バイトで 2 桁**、キリル文字は
+ * **2 バイトで 1 桁**である。バイト数を桁数として使っている所は全部ずれる。
+ *
+ * ## この層の役目
+ * 桁とバイトを**別の量として扱う**口を用意する。呼び出し側はここだけを通しておけば、
+ * 内部の符号化が SJIS から UTF-8 へ変わっても直す必要が無い。
+ *
+ * **いまはまだ SJIS / EUC で答える。**符号化を切り替えるのは別の段階で、
+ * この層へ移し終えてからにする（先に切り替えると、移していない所が全部化ける）。
+ *
+ * ## 使い分け
+ * ```
+ * バイト数を知りたい   → char_bytes() / next_char() / prev_char()
+ * 画面の桁を知りたい   → char_columns() / display_width()
+ * 桁で切りたい         → truncate_to_columns()   ※ 文字の途中で切らない
+ * 桁を揃えたい         → pad_to_columns()        ※ %-20s の代わり
+ * ```
+ *
+ * `%-20s` のような書式は**バイトで詰める**ので、日本語が混ざると桁が合わない。
+ * 桁を揃えたい所は `pad_to_columns()` を通すこと。
+ */
+#pragma once
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+
+namespace text {
+
+/*!
+ * @brief UTF-8 として測る道。**内部がまだ SJIS でも、これは常に UTF-8 として答える。**
+ * @details 分けて公開しているのは 2 つの理由から。
+ * 1. **切り替える前に試せる**。内部 UTF-8 化は `text-encoding.cpp` の
+ *    `kInternalIsUtf8` を切り替える段取りだが、切り替えてから初めて壊れているのが
+ *    判るのでは遅い。いまの build のまま UTF-8 の道を検査できるようにしておく。
+ * 2. 画面側や外部との境目は**いまでも UTF-8**（`sys_to_utf8()` の先）なので、
+ *    そこを測るのに内部の符号化とは別の口が要る。
+ */
+namespace utf8 {
+//! 先頭バイトから、その文字のバイト数を見込む（1〜4）。不正な先頭は 1。
+std::size_t bytes_from_lead(unsigned char lead);
+//! `pos` から始まる 1 文字のバイト数（1〜4）。壊れた並びは 1。
+std::size_t char_bytes(std::string_view str, std::size_t pos);
+/*!
+ * @brief `pos` から始まる 1 文字の表示桁数。
+ * @details **バイト数では決まらない。**キリル文字は 2 バイトだが 1 桁、
+ * 漢字は 3 バイトで 2 桁である。ここが SJIS（2 バイト＝2 桁）と決定的に違う。
+ */
+int char_columns(std::string_view str, std::size_t pos);
+//! 文字列全体の表示桁数。
+int display_width(std::string_view str);
+} // namespace utf8
+
+/*!
+ * @brief `pos` から始まる 1 文字のバイト数。
+ * @return 1 以上。`pos` が範囲外なら 0
+ * @details 壊れた並びに当たったら **1 を返して 1 バイト進ませる**（無限に止まらせない）。
+ */
+std::size_t char_bytes(std::string_view str, std::size_t pos);
+
+/*!
+ * @brief **1 バイト目だけ**から、その文字のバイト数を見込む（1 以上）。
+ *
+ * @details キーボードから 1 バイトずつ受け取る所のための口である
+ * （`inkey()` は 1 バイトしか返さないので、続きを何バイト読めばよいかを
+ * 先頭バイトから決めるしかない）。文字列が手元にある所では
+ * `char_bytes()` を使うこと——あちらは**末尾で切れていたら短く答える**が、
+ * こちらには切り詰める材料が無いので、**続きが来ない可能性は呼び出し側が見る**。
+ *
+ * @note SJIS の 2 バイト目・EUC の 2 バイト目を渡してはいけない（答えは無意味になる）。
+ * 渡すのは必ず**文字の 1 バイト目**である。
+ */
+std::size_t bytes_from_lead(unsigned char lead);
+
+/*!
+ * @brief NUL 終端の文字列の先頭 1 文字のバイト数。
+ * @return 1 以上。空文字列や nullptr なら 0
+ * @details `char *` で回している所（この木にはまだ多い）のための口。
+ * `std::string_view(ptr)` を作ると毎回 `strlen` が走って O(n^2) になるので、
+ * **先頭バイトと、その先が NUL かどうかだけ**を見る。
+ */
+std::size_t char_bytes(const char *str);
+
+/*!
+ * @brief `pos` から始まる 1 文字の表示桁数。
+ * @return 全角なら 2、半角なら 1。範囲外なら 0
+ */
+int char_columns(std::string_view str, std::size_t pos);
+
+//! 文字列全体の表示桁数。**バイト数ではない。**
+int display_width(std::string_view str);
+
+//! 次の文字の先頭へ。末尾まで来たら `str.size()` を返す。
+std::size_t next_char(std::string_view str, std::size_t pos);
+
+/*!
+ * @brief `pos` が**文字の先頭**か。
+ * @details `iskanji2(str, x)`（＝ x は全角の 2 バイト目か）の言い換え。
+ * 「2 バイト目か」で書くと SJIS の 2 バイト構造が前提になるが、
+ * 「文字の途中か」で書けば UTF-8 の 3 バイト目でも同じ意味で通る。
+ * 範囲外は true（そこで止まってよい、の意）。
+ */
+bool is_char_boundary(std::string_view str, std::size_t pos);
+
+/*!
+ * @brief `pos` が文字の頭で、かつその文字が**全角**か。
+ * @details `iskanji2(s, x)` の言い換え（あちらは「x まで文字を送って x にちょうど乗り、
+ * かつ x が全角の 1 バイト目」を意味していた）。**2 バイトかどうかではなく 2 桁かどうか**
+ * で書いてあるので、UTF-8 でもそのまま通る。カーソルを全角の上へ置くときに使う。
+ */
+bool is_wide_char_at(std::string_view str, std::size_t pos);
+
+/*!
+ * @brief 前の文字の先頭へ。先頭なら 0 のまま。
+ * @details 文字入力の後退（BS）で使う。**1 バイトだけ戻すと全角の途中で切れる。**
+ */
+std::size_t prev_char(std::string_view str, std::size_t pos);
+
+/*!
+ * @brief 表示桁数が `columns` を超えない範囲で切る。**文字の途中では切らない。**
+ * @details 全角が境目に跨るときは、その文字ごと落とす（半分だけ出すと化ける）。
+ */
+std::string_view truncate_to_columns(std::string_view str, int columns);
+
+/*!
+ * @brief 表示桁数を `columns` に揃える。足りなければ空白で埋め、溢れれば切る。
+ * @param left_align 左詰めなら true（`%-20s` 相当）、右詰めなら false（`%20s` 相当）
+ */
+std::string pad_to_columns(std::string_view str, int columns, bool left_align = true);
+
+/*!
+ * @brief この層の自己検査。**内部の符号化が何であっても通ること。**
+ * @param[out] report 落ちた項目の説明（通れば空）
+ * @return 通れば true
+ * @details 符号化を切り替える工事の途中で、この層が先に壊れていないかを見る門。
+ */
+bool self_check(std::string &report);
+
+} // namespace text
