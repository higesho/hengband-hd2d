@@ -0,0 +1,235 @@
+#include "core/realtime-clock.h"
+#include "core/player-processor.h"
+#include "game-option/cheat-options.h"
+#include "io/input-key-acceptor.h"
+#include "io/input-key-requester.h"
+#include "system/angband-system.h"
+#include "system/player-type-definition.h"
+#include "timed-effect/timed-effects.h"
+#include <algorithm>
+
+namespace {
+//! 1 刻みの下限。これより短くすると描画が追いつかない機体が出る。
+constexpr int MINIMUM_MS_PER_TICK = 10;
+//! 設計書 §2: 通常速度で 1 行動 = 10 刻み。
+constexpr int TICKS_PER_TURN_AT_NORMAL_SPEED = 10;
+}
+
+RealtimeClock &RealtimeClock::get_instance()
+{
+    static RealtimeClock instance{};
+    return instance;
+}
+
+bool RealtimeClock::is_enabled() const
+{
+    return this->enabled;
+}
+
+void RealtimeClock::set_enabled(bool enables)
+{
+    if (this->enabled == enables) {
+        return;
+    }
+
+    this->enabled = enables;
+    this->holding = false;
+    this->resync = true;
+}
+
+double RealtimeClock::get_seconds_per_turn() const
+{
+    return this->seconds_per_turn;
+}
+
+void RealtimeClock::set_seconds_per_turn(double seconds)
+{
+    const auto clamped = std::clamp(seconds, 0.2, 5.0);
+    // 毎フレーム呼ばれる（`apply_realtime_mode`）。**変わっていないなら張り直さない。**
+    // 毎回 resync を立てると締切が絶対時刻でなくなり、1 刻みが「呼ばれてから 1 刻み」に化ける。
+    if (this->seconds_per_turn == clamped) {
+        return;
+    }
+
+    this->seconds_per_turn = clamped;
+    this->resync = true;
+}
+
+int RealtimeClock::get_ms_per_tick() const
+{
+    if (this->ms_per_tick_now > 0) {
+        return this->ms_per_tick_now;
+    }
+
+    // まだ 1 度も行動していない（ロード直後など）。通常速度の目安で始める。
+    const auto ms = this->seconds_per_turn * 1000.0 / TICKS_PER_TURN_AT_NORMAL_SPEED;
+    return std::max(MINIMUM_MS_PER_TICK, static_cast<int>(ms));
+}
+
+double RealtimeClock::get_self_speed_span() const
+{
+    return this->self_speed_span;
+}
+
+void RealtimeClock::set_self_speed_span(double span)
+{
+    // 1.0 未満は意味を持たない（自分が「基準より遅くしか動けない」上限は下限と同じもの）。
+    this->self_speed_span = std::clamp(span, 1.0, 100.0);
+}
+
+void RealtimeClock::update_idle_tempo(int energy_per_tick)
+{
+    if (!this->enabled) {
+        return;
+    }
+
+    const auto per_tick = std::max(1, energy_per_tick);
+    const auto ratio = static_cast<double>(per_tick) / TICKS_PER_TURN_AT_NORMAL_SPEED;
+    const auto span = std::max(1.0, this->self_speed_span);
+    const auto self_ratio = std::clamp(ratio, 1.0 / span, span);
+
+    // 「1 行動＝100 エネルギー」を丸めずに割る。刻み数は整数でなくてよい。
+    const auto interval_ms = this->seconds_per_turn * 1000.0 / self_ratio;
+    const auto per_tick_ms = interval_ms * static_cast<double>(per_tick) / 100.0;
+    this->ms_per_tick_now = std::max(MINIMUM_MS_PER_TICK, static_cast<int>(per_tick_ms + 0.5));
+}
+
+void RealtimeClock::begin_action_stretch(int ticks_until_ready, int energy_per_tick, int energy_use)
+{
+    if (!this->enabled) {
+        return;
+    }
+
+    const auto ticks = std::max(1, ticks_until_ready);
+    const auto per_tick = std::max(1, energy_per_tick);
+    const auto cost = std::max(1, energy_use);
+
+    /*
+     * ここが設計の要。3 段で読める。
+     *
+     * ① 素の倍率  … 通常速度に対して何倍動けるか（`speed_to_energy` の比）。**変えてはいけない**。
+     *                これがゲームの有利不利そのもので、片方を削ると балансが崩れる。
+     * ② 自分の取り分 … ①のうち、**自分の行動間隔**へ回す分。振れ幅で頭打ちにする。
+     * ③ 残り        … ②で使い切れなかった分は、**世界の拍**へ自動的に載る。
+     *                  持ち時間を実際の刻み数で割るので、明示的に計算しなくてもそうなる。
+     */
+    const auto ratio = static_cast<double>(per_tick) / TICKS_PER_TURN_AT_NORMAL_SPEED;
+    const auto span = std::max(1.0, this->self_speed_span);
+    const auto self_ratio = std::clamp(ratio, 1.0 / span, span);
+
+    /*
+     * 持ち時間は**揺らぎを掛ける前のコスト**から出す（`energy_use` は普通の行動なら 100）。
+     * 揺らいだ実コストから出すと、足取りにそのまま揺れが乗る——直したかったのはそれである。
+     * 重い行動（コスト 200）はきちんと 2 倍の時間がかかる。
+     */
+    const auto interval_ms = this->seconds_per_turn * 1000.0 * (static_cast<double>(cost) / 100.0) / self_ratio;
+    const auto per_tick_ms = interval_ms / static_cast<double>(ticks);
+    this->ms_per_tick_now = std::max(MINIMUM_MS_PER_TICK, static_cast<int>(per_tick_ms + 0.5));
+}
+
+bool RealtimeClock::is_holding() const
+{
+    return this->holding;
+}
+
+void RealtimeClock::set_holding(bool holds)
+{
+    this->holding = holds;
+}
+
+bool RealtimeClock::is_prompt_background_allowed() const
+{
+    return this->prompt_background_allowed;
+}
+
+void RealtimeClock::set_prompt_background_allowed(bool allows)
+{
+    this->prompt_background_allowed = allows;
+}
+
+bool RealtimeClock::is_prompt_background_wanted() const
+{
+    return this->prompt_background_wanted;
+}
+
+void RealtimeClock::set_prompt_background_wanted(bool wants)
+{
+    this->prompt_background_wanted = wants;
+}
+
+bool RealtimeClock::is_stepping_world() const
+{
+    return this->stepping_world;
+}
+
+void RealtimeClock::set_stepping_world(bool steps)
+{
+    this->stepping_world = steps;
+}
+
+RealtimePromptScope::RealtimePromptScope()
+    : previous(RealtimeClock::get_instance().is_prompt_background_allowed())
+{
+    RealtimeClock::get_instance().set_prompt_background_allowed(true);
+}
+
+RealtimePromptScope::~RealtimePromptScope()
+{
+    RealtimeClock::get_instance().set_prompt_background_allowed(this->previous);
+}
+
+void RealtimeClock::request_resync()
+{
+    this->resync = true;
+}
+
+bool RealtimeClock::consume_resync()
+{
+    const auto requested = this->resync;
+    this->resync = false;
+    return requested;
+}
+
+bool can_pace_realtime_world(PlayerType *player_ptr)
+{
+    const auto &clock = RealtimeClock::get_instance();
+    if (!clock.is_enabled()) {
+        return false;
+    }
+
+    // 闘技場は自前の進行を持つ。時止め中はそもそも世界が止まっている。
+    if (AngbandSystem::get_instance().is_phase_out() || player_ptr->timewalk) {
+        return false;
+    }
+
+    // 走る・休む・旅・回数指定は早送りのまま（設計書 §9）。中断は既存の disturb が見る。
+    return !continuous_action_running(player_ptr);
+}
+
+bool can_wait_realtime_command(PlayerType *player_ptr)
+{
+    /*
+     * 待つ場面は進む場面の**部分集合**である。逆は成り立たない——麻痺の間は
+     * 「待たないが進む」。ここを取り違えると麻痺中だけ世界が CPU 速度で走る（ヘッダ参照）。
+     */
+    if (!can_pace_realtime_world(player_ptr)) {
+        return false;
+    }
+
+    // 麻痺・朦朧はコアが勝手に 100 消費する。締切で待つ場面ではない。
+    const auto effects = player_ptr->effects();
+    if (!cheat_immortal && (effects->paralysis().is_paralyzed() || effects->stun().is_knocked_out())) {
+        return false;
+    }
+
+    // キーマップ展開中・コマンド連鎖中は、Term のキュー越しに待っても意味がない。
+    if (command_new != 0) {
+        return false;
+    }
+
+    if ((inkey_next != nullptr) && (*inkey_next != '\0')) {
+        return false;
+    }
+
+    return true;
+}
