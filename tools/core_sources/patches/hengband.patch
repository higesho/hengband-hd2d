new file mode 100644
index 0000000..b77fe08
--- /dev/null
+++ b/src/core/combat-feedback.h
@@ -0,0 +1,87 @@
+#pragma once
+
+/*!
+ * @file combat-feedback.h
+ * @brief 戦闘の見せ場をコアが書き留める場所（docs/REALTIME_MODE_DESIGN.md §8）
+ * @details
+ * リアルタイムでは目が地図に張り付くので、メッセージが 1 行増えるだけでは
+ * **被弾にも命中にも気づけない**。ましてや小窓の裏で殴られているときは誰も読んでいない。
+ * そこで「何が・どこで・どの属性で起きたか」だけをここに積み、**見た目は画面側が決める**
+ * （必守制約 6: ui はコアに触らない／コアは見た目を知らない）。
+ *
+ * ## 属性はここに来る前に宣言する
+ * `take_hit` の呼び出しは 166 か所あるので引数は増やせない。代わりに
+ * 「次に起きる被弾はこの属性」を先に置いてもらう（`set_pending_attribute`）。
+ * 宣言する場所は 2 つだけで全部覆える:
+ * - 遠隔・呪文・ブレス … `affect_player`（`AttributeType` を既に受け取っている）
+ * - 近接打撃 … `MonsterAttackPlayer`（`mbe_info[効果].explode_type`）
+ * 宣言が無ければ「物理」に落ちる。罠・落下・毒・飢餓はそれでよい。
+ *
+ * ## 溜めっぱなしにしない
+ * 積むのはコア、汲むのは `Bridge::capture`。**`capture` は入力待ちの間も 10ms ごとに回る**
+ * ので、汲んだら消す（`take_events`）。消さずに `serial` で照合する作りにすると、
+ * 同じ縁を何度も拾って点滅し続ける（`TeleportFx::burst` と同じ罠）。
+ */
+
+#include "effect/attribute-types.h"
+
+#include <cstdint>
+#include <vector>
+
+class PlayerType;
+
+//! 何が起きたか。**見た目ではなく出来事**を書く（色や形は画面側の領分）。
+enum class CombatEventKind : uint8_t {
+    HIT_PLAYER = 0, //!< プレイヤーが受けた
+    HIT_MONSTER = 1, //!< モンスターに当てた
+    BOLT = 2, //!< 弾・矢・ブレスが飛んだ（`src` から `dst` へ）
+};
+
+struct CombatEvent {
+    CombatEventKind kind{ CombatEventKind::HIT_PLAYER };
+    AttributeType attribute{ AttributeType::NONE };
+    //! 起きた場所（`HIT_*` は当たった升、`BOLT` は着弾側）。
+    int y{ 0 };
+    int x{ 0 };
+    //! `BOLT` の撃った側。ほかの種類では `y`/`x` と同じ。
+    int src_y{ 0 };
+    int src_x{ 0 };
+    /*!
+     * @brief 強さ 0.0〜1.0。
+     * @details `HIT_PLAYER` は「減った HP ÷ 最大 HP」。かすり傷で画面が真っ赤になると
+     * 使い物にならないので、**割合**にしてある。`HIT_MONSTER` も相手の最大 HP に対する割合。
+     */
+    float intensity{ 0.f };
+};
+
+class CombatFeedback {
+public:
+    static CombatFeedback &get_instance();
+
+    CombatFeedback(const CombatFeedback &) = delete;
+    CombatFeedback &operator=(const CombatFeedback &) = delete;
+
+    //! 次に起きる被弾の属性を宣言する（`take_hit` へ引数を足さないための口）。
+    void set_pending_attribute(AttributeType attribute);
+    void clear_pending_attribute();
+
+    //! プレイヤーが受けた。`damage` と `mhp` から強さを出し、宣言済みの属性を消費する。
+    void record_player_hit(PlayerType *player_ptr, int damage, bool is_melee);
+    //! モンスターに当てた。
+    void record_monster_hit(int y, int x, int damage, int max_hp, AttributeType attribute);
+    //! 弾・矢・ブレスが飛んだ。
+    void record_bolt(int src_y, int src_x, int y, int x, AttributeType attribute);
+
+    //! 溜まっている分を持ち出して空にする（`Bridge::capture` が呼ぶ）。
+    std::vector<CombatEvent> take_events();
+
+private:
+    CombatFeedback() = default;
+
+    //! 1 フレームに積める上限。演出は数を出しても見えないので、溢れたら捨てる。
+    static constexpr size_t MAX_EVENTS = 32;
+
+    std::vector<CombatEvent> events;
+    AttributeType pending{ AttributeType::NONE };
+    bool has_pending{ false };
+};
