    "69b3873a8c49264bd32cc1c7f9577f00b127508acfd2a5d019d4c7bbfccb3161": {
      "encoding": "utf8",
      "text": "            umoria_command_input_active = false;\n"
    },
    "9474db0cab5234d34551fd29fc0984a0737874b33a5f7050663195bcd1ad509a": {
      "encoding": "utf8",
      "text": "extern bool umoria_command_input_active; // HD2D: set while game_run.cpp reads a command key\nbool umoria_build_town_from_map();               // HD2D: builds the town from umoria/hd2d/town.txt\nvoid umoria_town_start_position(Coord_t &coord);  // HD2D: start position on that map\n"
    },
    "c83803cb72c413464b0f581299e151e8ad803c797c62538064f3a06db1e3007c": {
      "encoding": "utf8",
      "text": "    umoria_town_start_position(coord); // HD2D: the map's start position (keeps coord without a map)\n"
    },
    "f8ebf575f89d9cffc998ffc1df36f3acc18815a021c240819d561ee3cbf41bc4": {
      "encoding": "utf8",
      "text": "            umoria_command_input_active = true; // HD2D: the frame tells the UI a command is awaited\n"
    },
    "fdc6688e1238a124b587ba8e39e6905905ceeb293140e4541f14f53a97e800f8": {
      "encoding": "utf8",
      "text": "    if (!umoria_build_town_from_map()) { // HD2D: the fixed town map\n"
    }
  },
